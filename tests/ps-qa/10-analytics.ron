// Every analytics tab must replace the rendered panel, not only update
// aria-selected on the control. The subject is unique content from that tab.
[
    (
        id: "analytics-refresh-completes",
        group: "analytics",
        what: "refreshing analytics completes a ledger read",
        open: Some("Analytics"),
        hover: None,
        click: Some("Refresh analytics"),
        subject: "Analytics refresh generation",
        expect: NameChanges,
    ),
    (
        id: "analytics-keyboard-next",
        group: "analytics",
        what: "the shared tab control moves to the next analytics panel by keyboard",
        open: Some("Analytics"),
        hover: None,
        click: None,
        type_into: None,
        text: None,
        key: Some("ArrowRight"),
        key_on: Some("tab:Value"),
        compare: None,
        subject: "Per item",
        expect: Paints,
    ),
    (
        id: "analytics-items",
        group: "analytics",
        what: "the Items analytics tab renders item outcomes",
        open: Some("Analytics"),
        hover: None,
        click: Some("Items"),
        subject: "Per item",
        expect: Paints,
    ),
    (
        id: "analytics-sessions",
        group: "analytics",
        what: "the Sessions analytics tab renders session outcomes",
        open: Some("Analytics"),
        hover: None,
        click: Some("Sessions"),
        subject: "Per session",
        expect: Paints,
    ),
    (
        id: "analytics-daily",
        group: "analytics",
        what: "the Daily analytics tab renders daily outcomes",
        open: Some("Analytics"),
        hover: None,
        click: Some("Daily"),
        subject: "Per day",
        expect: Paints,
    ),
    (
        id: "analytics-projects",
        group: "analytics",
        what: "the Projects analytics tab renders project outcomes",
        open: Some("Analytics"),
        hover: None,
        click: Some("Projects"),
        subject: "Per project",
        expect: Paints,
    ),
    (
        id: "analytics-models",
        group: "analytics",
        what: "the Models analytics tab renders model outcomes",
        open: Some("Analytics"),
        hover: None,
        click: Some("Models"),
        subject: "Per model",
        expect: Paints,
    ),
    (
        id: "analytics-value",
        group: "analytics",
        what: "the Value analytics tab renders value outcomes",
        open: Some("Analytics"),
        hover: None,
        click: Some("Value"),
        subject: "Outcome per dollar",
        expect: Paints,
    ),
]
