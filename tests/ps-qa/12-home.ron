// Home project-row controls and filtering. Repeated Pin controls are resolved
// to one painted node id; ValueChanges follows that same id after activation.
// Search runs last because it intentionally filters every fixture row away.
[
    (
        id: "home-task-manager-prompt-disabled-without-agent",
        group: "home",
        what: "the task-manager prompt is visibly unavailable when no task-manager agent can run",
        open: Some("Home"),
        hover: None,
        click: None,
        subject: "Task manager prompt",
        expect: Disabled,
    ),
    (
        id: "home-new-project",
        group: "home",
        what: "New Project opens an editable draft",
        open: Some("Home"),
        hover: None,
        click: Some("New Project"),
        subject: "textbox:Type to start your new project…",
        expect: PaintsNamed,
    ),
    (
        id: "home-project-opens",
        group: "home",
        what: "a project-row title opens that project",
        open: Some("Home"),
        hover: None,
        click: Some("Open project "),
        subject: "Send",
        expect: Paints,
    ),
    (
        id: "home-recent-project-opens",
        group: "home",
        what: "a Recent row opens that project",
        open: Some("Home"),
        hover: None,
        click: Some("Open recent project "),
        subject: "Send",
        expect: Paints,
    ),
    (
        id: "home-item-opens",
        group: "home",
        what: "an item-row title opens its owning project",
        open: Some("Home"),
        hover: None,
        click: Some("Open item "),
        subject: "Send",
        expect: Paints,
    ),
    (
        id: "home-close-draft",
        group: "home",
        what: "closing the Untitled draft removes its composer",
        open: Some("New project"),
        hover: None,
        click: Some("Close Untitled"),
        subject: "Type to start your new project…",
        expect: Vanishes,
    ),
    (
        id: "home-pin-project",
        group: "home",
        what: "pinning a project changes the exact row control",
        open: Some("Home"),
        hover: None,
        click: Some("Pin project"),
        subject: "Pin project",
        expect: SelectionChanges,
    ),
    (
        id: "home-unpin-project",
        group: "home",
        what: "the same project row can be unpinned again",
        open: Some("Home"),
        hover: None,
        click: Some("Unpin project"),
        subject: "Unpin project",
        expect: SelectionChanges,
    ),
    (
        id: "home-item-edit-opens",
        group: "home",
        what: "an item-row pencil opens the exact inline title editor",
        open: Some("Home"),
        hover: Some("Change the status of iota beta zeta delta north cobalt epsilon omega lambda epsilon"),
        click: Some("button:Edit iota beta zeta delta north cobalt epsilon omega lambda epsilon"),
        subject: "textbox:Edit iota beta zeta delta north cobalt epsilon omega lambda epsilon",
        expect: PaintsNamed,
        covers: ["button:Edit *"],
    ),
    (
        id: "home-item-edit-persists",
        group: "home",
        what: "the inline item editor saves a replacement title on Enter",
        open: None,
        hover: None,
        click: None,
        type_into: Some("textbox:Edit iota beta zeta delta north cobalt epsilon omega lambda epsilon"),
        text: Some("qa audit edited item"),
        key: Some("Enter"),
        key_on: Some("textbox:Edit iota beta zeta delta north cobalt epsilon omega lambda epsilon"),
        subject: "button:Edit qa audit edited item",
        expect: PaintsNamed,
    ),
    (
        id: "home-item-delete-removes-row",
        group: "home",
        what: "an item-row delete control removes the exact disposable item",
        open: Some("Home"),
        hover: Some("Change the status of qa audit edited item"),
        click: Some("button:Delete qa audit edited item"),
        subject: "button:Delete qa audit edited item",
        expect: Vanishes,
        covers: ["button:Delete *"],
    ),
    (
        id: "home-collapse-project",
        group: "home",
        what: "a project group can be collapsed",
        open: Some("Home"),
        hover: None,
        click: Some("Collapse project "),
        subject: "Expand project ",
        expect: Paints,
    ),
    (
        id: "home-expand-project",
        group: "home",
        what: "a project group can be expanded again",
        open: Some("Home"),
        hover: None,
        click: Some("Expand project "),
        subject: "Collapse project ",
        expect: Paints,
    ),
    (
        id: "home-search-filters",
        group: "home",
        what: "project search removes non-matching rows from the screen",
        open: Some("Home"),
        hover: None,
        click: None,
        type_into: Some("Search projects and items"),
        text: Some("qa-no-project-has-this-name"),
        subject: "theta theta north indi",
        expect: Vanishes,
    ),
    (
        id: "home-search-restores",
        group: "home",
        what: "clearing project search restores the filtered project rows",
        open: Some("Home"),
        hover: None,
        click: None,
        type_into: Some("Search projects and items"),
        text: Some(""),
        subject: "theta theta north indi",
        expect: Paints,
    ),
    (
        id: "home-task-manager-debug",
        group: "home",
        what: "the task-manager diagnostics reveal changes state",
        open: Some("Home"),
        hover: None,
        click: Some("Show the task manager's reply and collected list"),
        subject: "Show the task manager's reply and collected list",
        expect: SelectionChanges,
    ),
    (
        id: "home-prompt-shrinks",
        group: "home",
        what: "the task-manager prompt can return to one line",
        open: Some("Home"),
        hover: None,
        click: Some("Shrink the prompt area"),
        subject: "Expand the prompt area",
        expect: Paints,
    ),
    (
        id: "home-prompt-expands",
        group: "home",
        what: "the task-manager prompt can expand again",
        open: Some("Home"),
        hover: None,
        click: Some("Expand the prompt area"),
        subject: "Shrink the prompt area",
        expect: Paints,
    ),
]
