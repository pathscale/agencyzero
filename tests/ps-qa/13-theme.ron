// Appearance choices expose aria-pressed/checked values. Follow the exact
// semantic node through each change, then restore the starting mode, size and
// glass state. The colour-composition stops and glass axes are standard UI
// controls too: audit their semantic values rather than trusting their paint.
[
    (
        id: "switch-reveals-appearance",
        group: "switch",
        what: "Settings search reveals Appearance before the shared glass Switch is driven",
        open: Some("Settings"),
        hover: None,
        click: None,
        type_into: Some("Search settings"),
        text: Some("Appearance"),
        subject: "button:Light",
        expect: PaintsNamed,
    ),
    (
        id: "theme-reveals-appearance",
        group: "theme",
        what: "the Settings search reveals the Appearance controls for semantic activation",
        open: Some("Settings"),
        hover: None,
        click: None,
        type_into: Some("Search settings"),
        text: Some("Appearance"),
        subject: "button:Light",
        expect: PaintsNamed,
    ),
    (
        id: "theme-base-colour-first-paint",
        group: "theme-first-paint",
        what: "revealing Appearance paints the same neutral colour flower before and after its first hover",
        open: Some("Settings"),
        hover: None,
        after_prepare_hover: Some("radio:Theme color "),
        click: None,
        type_into: Some("Search settings"),
        text: Some("Appearance"),
        reveal_before_capture: Some("radio:Theme color "),
        subject: "@color-wheel-flower",
        expect: PixelsHoldAfterHover,
    ),
    (
        id: "theme-base-colour-contained",
        group: "theme-first-paint",
        what: "revealing Appearance keeps every theme-colour petal inside the flower",
        open: Some("Settings"),
        hover: None,
        click: None,
        type_into: Some("Search settings"),
        text: Some("Appearance"),
        compare: Some("@color-wheel-flower"),
        subject: "radio:Theme color ",
        expect: ContainedBy,
    ),
    (
        id: "theme-base-colour-hover-feedback",
        group: "theme-first-paint",
        what: "hovering a theme-colour petal visibly raises and outlines it",
        open: Some("Settings"),
        hover: None,
        after_prepare_hover: Some("radio:Theme color "),
        click: None,
        type_into: Some("Search settings"),
        text: Some("Appearance"),
        reveal_before_capture: Some("radio:Theme color "),
        subject: "@color-wheel-flower",
        expect: PixelsChange,
    ),
    (
        id: "theme-light-mode",
        group: "theme",
        what: "Light mode can be selected",
        open: Some("Settings"),
        hover: None,
        click: Some("Light"),
        subject: "Light",
        expect: SelectionChanges,
    ),
    (
        id: "theme-dark-mode",
        group: "theme",
        what: "Dark mode can be restored",
        open: Some("Settings"),
        hover: None,
        click: Some("Dark"),
        subject: "Dark",
        expect: SelectionChanges,
    ),
    (
        id: "theme-large-size",
        group: "theme",
        what: "Large interface size can be selected",
        open: Some("Settings"),
        setup_type_into: Some("Search settings"),
        setup_text: Some("Interface size"),
        hover: None,
        click: Some("Large Interface size"),
        subject: "Large Interface size",
        expect: SelectionChanges,
    ),
    (
        id: "theme-extra-large-size",
        group: "theme",
        what: "Extra-large interface size is materially larger than an ordinary control",
        open: Some("Settings"),
        setup_type_into: Some("Search settings"),
        setup_text: Some("Interface size"),
        prepare: Some("Extra large Interface size"),
        hover: None,
        click: None,
        subject: "button:Extra large Interface size",
        expect_size: Some("34x34"),
        expect: Measures,
    ),
    (
        id: "theme-normal-size",
        group: "theme",
        what: "Normal interface size can be restored before the typography comparison",
        open: Some("Settings"),
        setup_type_into: Some("Search settings"),
        setup_text: Some("Interface size"),
        hover: None,
        click: Some("Normal Interface size"),
        subject: "Normal Interface size",
        expect: SelectionChanges,
    ),
    (
        id: "theme-extra-large-font-size",
        group: "theme",
        what: "Extra-large increases the resolved font size of real Settings text",
        open: Some("Settings"),
        setup_type_into: Some("Search settings"),
        setup_text: Some("Interface size"),
        prepare: Some("Normal Interface size"),
        hover: None,
        click: Some("Extra large Interface size"),
        subject: "heading:Appearance",
        expect: FontSizeGrows,
    ),
    (
        id: "theme-extra-large-turn-bar-stays-single-line",
        group: "theme",
        what: "Extra-large typography expands an agent bubble instead of wrapping its turn bar",
        open: Some("Settings"),
        setup_type_into: Some("Search settings"),
        setup_text: Some("Interface size"),
        prepare: Some("Extra large Interface size"),
        hover: None,
        click: Some("theta theta north indi"),
        subject: "@turn-bar",
        expect_size: Some("x<=24"),
        expect: Measures,
    ),
    (
        id: "theme-normal-size-final",
        group: "theme",
        what: "Normal interface size is restored after the typography comparison",
        open: Some("Settings"),
        setup_type_into: Some("Search settings"),
        setup_text: Some("Interface size"),
        hover: None,
        click: Some("Normal Interface size"),
        subject: "Normal Interface size",
        expect: SelectionChanges,
    ),
    (
        id: "theme-colour-strength",
        group: "theme",
        what: "the standard colour wheel changes surface strength",
        open: Some("Settings"),
        hover: None,
        click: Some("Colour strength 20%"),
        covers: ["button:Colour strength "],
        subject: "Colour strength 20%",
        expect: SelectionChanges,
    ),
    (
        id: "theme-colour-strength-restores",
        group: "theme",
        what: "surface strength can be put back, leaving the theme as it was",
        open: Some("Settings"),
        hover: None,
        // The stop the fixture ships. The check before this one moves it to
        // 20%, so the group leaves the theme where it found it and can be run
        // twice against one instance.
        click: Some("Colour strength 10%"),
        covers: ["button:Colour strength "],
        subject: "Colour strength 10%",
        expect: SelectionChanges,
    ),
    (
        id: "theme-adjustment-axes-lay-out-apart",
        group: "theme",
        what: "the wheel's adjustment axes each occupy their own position",
        open: Some("Settings"),
        hover: None,
        click: None,
        /*
         * The three axes are one component's rows, and they were a single
         * column whatever room they had. `ComplexColorWheel` now chooses by the
         * width it is given, so what has to hold either way is that the axes
         * are laid out apart rather than stacked on one another: a family drawn
         * at one position is the failure a column-or-grid change can introduce
         * without changing any label or value.
         */
        subject: "button:Colour strength ",
        expect: DistinctPositions,
    ),
    (
        id: "theme-adjustment-axes-sit-beside-wheel",
        group: "theme",
        what: "desktop Appearance places the colour adjustments to the right of the wheel",
        open: Some("Settings"),
        hover: None,
        click: None,
        type_into: Some("Search settings"),
        text: Some("Appearance"),
        compare: Some("@color-wheel-flower"),
        subject: "button:Colour strength ",
        expect: RightOf,
    ),
    (
        id: "theme-softness",
        group: "theme",
        what: "the standard colour wheel changes surface softness",
        open: Some("Settings"),
        hover: None,
        click: Some("Softness 50%"),
        covers: ["button:Softness "],
        subject: "Softness 50%",
        expect: SelectionChanges,
    ),
    (
        id: "theme-text-brightness",
        group: "theme",
        what: "the standard colour wheel changes text brightness",
        open: Some("Settings"),
        hover: None,
        click: Some("Text brightness 75%"),
        covers: ["button:Text brightness "],
        subject: "Text brightness 75%",
        expect: SelectionChanges,
    ),
    (
        id: "theme-control-accent",
        group: "theme",
        what: "the standard primary-accent swatches change selection",
        open: Some("Settings"),
        hover: None,
        click: Some("Accent colour 2"),
        covers: ["button:Accent colour"],
        subject: "Accent colour 2",
        expect: SelectionChanges,
    ),
    (
        id: "theme-control-accent-restores",
        group: "theme",
        what: "the primary accent can return to the designed default",
        open: Some("Settings"),
        hover: None,
        click: Some("Accent colour: Designed yellow accent"),
        subject: "Accent colour: Designed yellow accent",
        expect: SelectionChanges,
    ),
    (
        id: "theme-art-accent",
        group: "theme",
        what: "the standard artwork-accent swatches change selection",
        open: Some("Settings"),
        hover: None,
        click: Some("Accent 2 2"),
        covers: ["button:Accent 2"],
        subject: "Accent 2 2",
        expect: SelectionChanges,
    ),
    (
        id: "theme-art-accent-restores",
        group: "theme",
        what: "the artwork accent can return to the designed default",
        open: Some("Settings"),
        hover: None,
        click: Some("Accent 2: Designed yellow accent"),
        subject: "Accent 2: Designed yellow accent",
        expect: SelectionChanges,
    ),
    (
        id: "theme-base-colour-layout",
        group: "theme",
        what: "the standard theme-colour radio family paints as a flower rather than one stacked control",
        open: Some("Settings"),
        hover: None,
        click: None,
        covers: [],
        subject: "radio:Theme color ",
        expect: DistinctPositions,
    ),
    (
        id: "theme-base-colour",
        group: "theme",
        what: "the standard theme-colour radio family changes the surface colour",
        open: Some("Settings"),
        prepare: Some("Theme color #AE3270"),
        hover: None,
        click: Some("Theme color #AE7032"),
        covers: ["radio:Theme color ", "#settings-theme-surface-flower-petal-30"],
        subject: "Theme color #AE7032",
        expect: SelectionChanges,
    ),
    (
        id: "theme-glass-blur",
        group: "theme",
        what: "moving glass blur from maximum to zero changes the semantic blur value",
        open: Some("Settings"),
        prepare: Some("Glass blur"),
        prepare_key: Some("End"),
        hover: None,
        click: None,
        key: Some("Home"),
        key_on: Some("Glass blur"),
        compare: None,
        subject: "Glass blur",
        expect: ValueChanges,
    ),
    (
        id: "theme-glass-blur-restores",
