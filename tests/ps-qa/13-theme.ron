// Appearance choices expose aria-pressed/checked values. Follow the exact
// semantic node through each change, then restore the starting mode, size and
// glass state. The colour-composition stops and glass axes are standard UI
// controls too: audit their semantic values rather than trusting their paint.
[
    (
        id: "theme-light-mode",
        group: "theme",
        what: "Light mode can be selected",
        open: Some("Settings"),
        hover: None,
        click: Some("Light"),
        subject: "Light",
        expect: ValueChanges,
    ),
    (
        id: "theme-dark-mode",
        group: "theme",
        what: "Dark mode can be restored",
        open: Some("Settings"),
        hover: None,
        click: Some("Dark"),
        subject: "Dark",
        expect: ValueChanges,
    ),
    (
        id: "theme-large-size",
        group: "theme",
        what: "Large interface size can be selected",
        open: Some("Settings"),
        hover: None,
        click: Some("Large Interface size"),
        subject: "Large Interface size",
        expect: ValueChanges,
    ),
    (
        id: "theme-normal-size",
        group: "theme",
        what: "Normal interface size can be restored",
        open: Some("Settings"),
        hover: None,
        click: Some("Normal Interface size"),
        subject: "Normal Interface size",
        expect: ValueChanges,
    ),
    (
        id: "theme-colour-strength",
        group: "theme",
        what: "the standard colour wheel changes surface strength",
        open: Some("Settings"),
        hover: None,
        click: Some("Colour strength 20%"),
        covers: ["button:Colour strength "],
        subject: "Colour strength 20%",
        expect: ValueChanges,
    ),
    (
        id: "theme-softness",
        group: "theme",
        what: "the standard colour wheel changes surface softness",
        open: Some("Settings"),
        hover: None,
        click: Some("Softness 50%"),
        covers: ["button:Softness "],
        subject: "Softness 50%",
        expect: ValueChanges,
    ),
    (
        id: "theme-text-brightness",
        group: "theme",
        what: "the standard colour wheel changes text brightness",
        open: Some("Settings"),
        hover: None,
        click: Some("Text brightness 50%"),
        covers: ["button:Text brightness "],
        subject: "Text brightness 50%",
        expect: ValueChanges,
    ),
    (
        id: "theme-control-accent",
        group: "theme",
        what: "the standard primary-accent swatches change selection",
        open: Some("Settings"),
        hover: None,
        click: Some("Accent colour 2"),
        covers: ["button:Accent colour"],
        subject: "Accent colour 2",
        expect: ValueChanges,
    ),
    (
        id: "theme-control-accent-restores",
        group: "theme",
        what: "the primary accent can return to the designed default",
        open: Some("Settings"),
        hover: None,
        click: Some("Accent colour: Designed yellow accent"),
        subject: "Accent colour: Designed yellow accent",
        expect: ValueChanges,
    ),
    (
        id: "theme-art-accent",
        group: "theme",
        what: "the standard artwork-accent swatches change selection",
        open: Some("Settings"),
        hover: None,
        click: Some("Accent 2 2"),
        covers: ["button:Accent 2"],
        subject: "Accent 2 2",
        expect: ValueChanges,
    ),
    (
        id: "theme-art-accent-restores",
        group: "theme",
        what: "the artwork accent can return to the designed default",
        open: Some("Settings"),
        hover: None,
        click: Some("Accent 2: Designed yellow accent"),
        subject: "Accent 2: Designed yellow accent",
        expect: ValueChanges,
    ),
    (
        id: "theme-base-colour",
        group: "theme",
        what: "the standard theme-colour radio family changes the surface colour",
        open: Some("Settings"),
        hover: None,
        click: Some("Theme color #AE7032"),
        covers: ["radio:Theme color "],
        subject: "Theme color #AE7032",
        expect: ValueChanges,
    ),
    (
        id: "theme-glass-blur",
        group: "theme",
        what: "the glass blur axis changes through its semantic slider",
        open: Some("Settings"),
        hover: None,
        click: None,
        type_into: None,
        text: None,
        key: Some("Right"),
        key_on: Some("Glass blur"),
        compare: None,
        subject: "Glass blur",
        expect: ValueChanges,
    ),
    (
        id: "theme-glass-refraction",
        group: "theme",
        what: "the glass refraction axis changes through its semantic slider",
        open: Some("Settings"),
        hover: None,
        click: None,
        type_into: None,
        text: None,
        key: Some("Right"),
        key_on: Some("Glass refraction"),
        compare: None,
        subject: "Glass refraction",
        expect: ValueChanges,
    ),
    (
        id: "theme-glass-depth",
        group: "theme",
        what: "the glass depth axis changes through its semantic slider",
        open: Some("Settings"),
        hover: None,
        click: None,
        type_into: None,
        text: None,
        key: Some("Right"),
        key_on: Some("Glass depth"),
        compare: None,
        subject: "Glass depth",
        expect: ValueChanges,
    ),
    (
        id: "theme-glass-opacity",
        group: "theme",
        what: "the glass opacity axis changes through its semantic slider",
        open: Some("Settings"),
        hover: None,
        click: None,
        type_into: None,
        text: None,
        key: Some("Right"),
        key_on: Some("Glass opacity"),
        compare: None,
        subject: "Glass opacity",
        expect: ValueChanges,
    ),
    (
        id: "theme-glass-scrim",
        group: "theme",
        what: "the glass scrim axis changes through its semantic slider",
        open: Some("Settings"),
        hover: None,
        click: None,
        type_into: None,
        text: None,
        key: Some("Right"),
        key_on: Some("Glass scrim"),
        compare: None,
        subject: "Glass scrim",
        expect: ValueChanges,
    ),
    (
        id: "theme-glass-toggle",
        group: "theme",
        what: "the global glass setting changes",
        open: Some("Settings"),
        hover: None,
        click: Some("Glass"),
        subject: "Glass",
        expect: ValueChanges,
    ),
    (
        id: "theme-glass-restores",
        group: "theme",
        what: "the global glass setting can be restored",
        open: Some("Settings"),
        hover: None,
        click: Some("Glass"),
        subject: "Glass",
        expect: ValueChanges,
    ),
]
