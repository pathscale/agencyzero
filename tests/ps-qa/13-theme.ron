// Appearance choices expose aria-pressed/checked values. Follow the exact
// semantic node through each change, then restore the starting mode and size.
[
    (
        id: "theme-light-mode",
        group: "theme",
        what: "Light mode can be selected",
        open: Some("Settings"),
        hover: None,
        click: Some("Light"),
        subject: "Light",
        expect: ValueChanges,
    ),
    (
        id: "theme-dark-mode",
        group: "theme",
        what: "Dark mode can be restored",
        open: Some("Settings"),
        hover: None,
        click: Some("Dark"),
        subject: "Dark",
        expect: ValueChanges,
    ),
    (
        id: "theme-large-size",
        group: "theme",
        what: "Large interface size can be selected",
        open: Some("Settings"),
        hover: None,
        click: Some("Large Interface size"),
        subject: "Large Interface size",
        expect: ValueChanges,
    ),
    (
        id: "theme-normal-size",
        group: "theme",
        what: "Normal interface size can be restored",
        open: Some("Settings"),
        hover: None,
        click: Some("Normal Interface size"),
        subject: "Normal Interface size",
        expect: ValueChanges,
    ),
    (
        id: "theme-glass-toggle",
        group: "theme",
        what: "the global glass setting changes",
        open: Some("Settings"),
        hover: None,
        click: Some("Glass"),
        subject: "Glass",
        expect: ValueChanges,
    ),
]
