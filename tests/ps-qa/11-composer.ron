// Composer controls are per-tab state. Menus must render their choices, while
// toggles must change either their semantic value or their inverse label.
[
    (
        id: "composer-body-is-flat",
        group: "composer",
        what: "the composer body owns an opaque flat fill while its border animates independently",
        open: Some("theta theta north indi"),
        hover: None,
        click: None,
        subject: "Ask, or type / for commands…",
        expect: OpaqueBackground,
    ),
    (
        id: "composer-advanced",
        group: "composer",
        what: "Prompt Syntax advanced mode changes",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Parse Prompt Syntax controls before sending"),
        subject: "Parse Prompt Syntax controls before sending",
        expect: SelectionChanges,
    ),
    (
        id: "composer-advanced-restores",
        group: "composer",
        what: "Prompt Syntax advanced mode can be restored before an ordinary send",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Parse Prompt Syntax controls before sending"),
        subject: "Parse Prompt Syntax controls before sending",
        expect: SelectionChanges,
    ),
    (
        /*
         * Hovering the pill repeatedly leaves nothing behind.
         *
         * The pill's hover changes its border and runs a colour transition. A
         * hover that appends something and never removes it looks correct the
         * first time and accumulates from the second, so a check that enters
         * once cannot see it and neither can anyone who does not happen to
         * hover twice by hand. This was reported from a real build as the pill
         * dropdowns being visibly broken.
         *
         * The count is the whole check: `("Permission", 8)` enters eight times,
         * leaving between each, and the harness compares the tree before the
         * first entry against after the last. `Holds` states the contract the
         * comparison enforces - whatever the hover adds, it takes away again.
         */
        /*
         * The pill is the height it is designed to be.
         *
         * `PillMenu` declares `h-[24px] min-h-[24px]`. Measured on a running
         * app the trigger is 27.8px, so something is adding 3.8px that the
         * fixed height was supposed to prevent - a border, a line-height, or a
         * padding that survived a change it should not have.
         *
         * Nothing else here can see that: every other assertion is satisfied
         * by any non-zero box, so a pill at 8px or at 28px passes them all.
         */
        /*
         * The whole cycle: open the pill, choose a value, and read the trigger.
         *
         * Every other check here asks half the question. `-opens` proves a menu
         * appears and `-height` proves the trigger is the size it claims, and a
         * dropdown can pass both while being useless: it opens, you click, and
         * nothing happens. That is what "the pill dropdowns are broken" means
         * to somebody using the app, and nothing in this suite was asking it.
         *
         * Driven the way a reader drives it. `prepare` presses the trigger by
         * the name it currently reads, the click names the item by *role* and
         * name, and the assertion is on the trigger rather than the item: an
         * option that highlights without committing is exactly the failure.
         *
         * Addressing by `menuitem:` is not decoration. A bare "Plan" matched a
         * token-usage tooltip elsewhere on screen containing the word, pressed
         * that instead, and reported success while the value never changed.
         *
         * "Bypass" rather than a likelier value, because the assertion is that
         * the name *changed*: choosing whatever the pill already reads is a
         * no-op and would fail a working component. The QA profile ships with
         * this pill on a different setting.
         */
        id: "composer-permission-selects-and-commits",
        group: "composer",
        what: "choosing a permission changes what the pill trigger reads",
        open: Some("theta theta north indi"),
        prepare: Some("Permission"),
        hover: None,
        click: Some("menuitem:Bypass"),
        subject: "Permission",
        expect: NameChanges,
    ),
    (
        id: "composer-permission-hover-leaves-nothing",
        group: "composer",
        what: "hovering the Permission pill repeatedly adds no lasting nodes",
        open: Some("theta theta north indi"),
        prepare: None,
        hover: Some(("Permission", 8)),
        click: None,
        subject: "Permission",
        expect: Holds,
    ),
    (
        // The same for the Model pill, which is the other one in the composer
        // and carries a two-tone label the Permission pill does not.
        id: "composer-model-hover-leaves-nothing",
        group: "composer",
        what: "hovering the Model pill repeatedly adds no lasting nodes",
        open: Some("theta theta north indi"),
        prepare: None,
        hover: Some(("Model", 8)),
        click: None,
        subject: "Model",
        expect: Holds,
    ),
    (
        id: "composer-permission-selects-option",
        group: "composer",
        what: "choosing Edit changes the composer permission trigger's accessible value",
        open: Some("theta theta north indi"),
        prepare: Some("Permission"),
        hover: None,
        click: Some("menuitem:Edit"),
        subject: "Permission",
        expect: NameChanges,
    ),
    (
        id: "composer-restore-prompt",
        group: "composer",
        what: "the composer can restore its prompt area",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Restore the prompt size"),
        subject: "Expand the prompt",
        expect: Paints,
    ),
    (
        id: "composer-expand-prompt",
        group: "composer",
        what: "the composer can expand its prompt area",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Expand the prompt"),
        subject: "Restore the prompt size",
        expect: Paints,
    ),
    (
        id: "composer-extra-thinking",
        group: "composer",
        what: "the tab's extra-thinking setting changes",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Extra Thinking: let the model reason before it answers"),
        subject: "Extra Thinking: let the model reason before it answers",
        expect: SelectionChanges,
    ),
    (
        // Paired with the restore below, so this group is repeatable.
        //
        // A `NameChanges` check that leaves the control on its new value
        // passes once and fails every time after, because the second run
        // selects a value the pill already holds. Both of these read as
        // application defects - "accessible name stayed" - when the previous
        // run is the only thing that changed.
        id: "composer-model-selects-option",
        group: "composer",
        what: "choosing Opus changes the exact composer model trigger",
        open: Some("theta theta north indi"),
        prepare: Some("button:Model:"),
        hover: None,
        // Named in full. "Opus" alone is a substring of all four Claude
        // entries, so which one it selected depended on tree order, and the
        // restore below could not know what to undo.
        click: Some("menuitem:Claude · Claude Opus 5"),
        subject: "button:Model:",
        expect: NameChanges,
    ),
    (
        id: "composer-model-restores",
        group: "composer",
        what: "the Model pill returns to its default for the rest of the audit",
        open: Some("theta theta north indi"),
        prepare: Some("button:Model:"),
        hover: None,
        // The default this profile starts on, read from the live menu rather
        // than assumed: the options are all "Claude - Opus ..." variants and
        // there is no Sonnet entry to go back to.
        click: Some("menuitem:Claude · Opus (1M context)"),
        subject: "button:Model:",
        expect: NameChanges,
    ),
    (
        id: "composer-effort-selects-option",
        group: "composer",
        what: "choosing high changes the composer effort trigger's accessible value",
        open: Some("theta theta north indi"),
        prepare: Some("Effort"),
        hover: None,
        // `high`, not `medium`: the composer starts on medium, so selecting it
        // asserted a change that could not happen and the check failed against
        // a working application. A `NameChanges` check has to name a value the
        // control does not already hold.
        click: Some("menuitem:high"),
        subject: "Effort",
        expect: NameChanges,
    ),
    (
        id: "composer-effort-restores",
        group: "composer",
        what: "the Effort pill returns to medium for the rest of the audit",
        open: Some("theta theta north indi"),
        prepare: Some("Effort"),
        hover: None,
        click: Some("menuitem:medium"),
        subject: "Effort",
        expect: NameChanges,
    ),
    (
        id: "composer-send-disabled-without-draft",
        group: "composer",
        what: "Send is visibly unavailable while the composer is empty",
        open: Some("theta theta north indi"),
        hover: None,
        click: None,
        subject: "button:Send",
        expect: Disabled,
    ),
    (
        id: "composer-draft-preserves-agent-gate",
        group: "composer",
        what: "a draft does not bypass the disconnected-agent Send gate",
        open: Some("theta theta north indi"),
        hover: None,
        click: None,
        type_into: Some("Ask, or type / for commands…"),
        text: Some("qa draft only"),
        subject: "button:Send",
        expect: Disabled,
    ),
]
