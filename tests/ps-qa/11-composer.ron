// Composer controls are per-tab state. Menus must render their choices, while
// toggles must change either their semantic value or their inverse label.
[
    (
        id: "composer-advanced",
        group: "composer",
        what: "Prompt Syntax advanced mode changes",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Parse Prompt Syntax controls before sending"),
        subject: "Parse Prompt Syntax controls before sending",
        expect: SelectionChanges,
    ),
    (
        id: "composer-advanced-restores",
        group: "composer",
        what: "Prompt Syntax advanced mode can be restored before an ordinary send",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Parse Prompt Syntax controls before sending"),
        subject: "Parse Prompt Syntax controls before sending",
        expect: SelectionChanges,
    ),
    (
        id: "composer-permission-menu",
        group: "composer",
        what: "the tab permission control opens its choices",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Permission"),
        subject: "menuitem:Read-only",
        expect: PaintsNamed,
    ),
    (
        id: "composer-permission-selects-option",
        group: "composer",
        what: "choosing Edit changes the composer permission trigger's accessible value",
        open: None,
        prepare: Some("Permission"),
        hover: None,
        click: Some("menuitem:Edit"),
        subject: "Permission",
        expect: NameChanges,
    ),
    (
        id: "composer-restore-prompt",
        group: "composer",
        what: "the composer can restore its prompt area",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Restore the prompt size"),
        subject: "Expand the prompt",
        expect: Paints,
    ),
    (
        id: "composer-expand-prompt",
        group: "composer",
        what: "the composer can expand its prompt area",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Expand the prompt"),
        subject: "Restore the prompt size",
        expect: Paints,
    ),
    (
        id: "composer-extra-thinking",
        group: "composer",
        what: "the tab's extra-thinking setting changes",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Extra Thinking: let the model reason before it answers"),
        subject: "Extra Thinking: let the model reason before it answers",
        expect: SelectionChanges,
    ),
    (
        id: "composer-model-menu",
        group: "composer",
        what: "the tab model selector opens its available choices",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("button:Model:"),
        subject: "menuitem",
        expect: PaintsMore,
    ),
    (
        id: "composer-model-selects-option",
        group: "composer",
        what: "choosing Opus changes the exact composer model trigger",
        open: None,
        prepare: Some("button:Model:"),
        hover: None,
        click: Some("menuitem:Opus"),
        subject: "button:Model:",
        expect: NameChanges,
    ),
    (
        id: "composer-effort-menu",
        group: "composer",
        what: "the tab effort control opens its choices",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Effort"),
        subject: "menuitem:medium",
        expect: PaintsNamed,
    ),
    (
        id: "composer-effort-selects-option",
        group: "composer",
        what: "choosing medium changes the composer effort trigger's accessible value",
        open: None,
        prepare: Some("Effort"),
        hover: None,
        click: Some("menuitem:medium"),
        subject: "Effort",
        expect: NameChanges,
    ),
    (
        id: "composer-send-disabled-without-draft",
        group: "composer",
        what: "Send is visibly unavailable while the composer is empty",
        open: Some("theta theta north indi"),
        hover: None,
        click: None,
        subject: "button:Send",
        expect: Disabled,
    ),
    (
        id: "composer-draft-preserves-agent-gate",
        group: "composer",
        what: "a draft does not bypass the disconnected-agent Send gate",
        open: Some("theta theta north indi"),
        hover: None,
        click: None,
        type_into: Some("Ask, or type / for commands…"),
        text: Some("qa draft only"),
        subject: "button:Send",
        expect: Disabled,
    ),
]
