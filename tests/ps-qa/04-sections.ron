// Collapse and expand round-trip, and the headers are on screen to begin with.
[
    (
        id: "sections-1",
        group: "sections",
        what: "the Items section header is on screen",
        open: Some("theta theta north indi"),
        hover: None, click: None,
        subject: "Items",
        expect: Paints,
    ),
    (
        id: "sections-2",
        group: "sections",
        what: "the Task log section header is on screen",
        open: Some("theta theta north indi"),
        hover: None, click: None,
        subject: "Task log",
        expect: Paints,
    ),
    (
        id: "sections-3",
        group: "sections",
        what: "the Agent I/O section header is on screen",
        open: Some("theta theta north indi"),
        hover: None, click: None,
        subject: "Agent I/O",
        expect: Paints,
    ),
    (
        id: "sections-4",
        group: "sections",
        what: "collapsing a section is acknowledged",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Collapse Task log"),
        subject: "Expand Task log",
        expect: Paints,
    ),
    (
        id: "sections-5",
        group: "sections",
        what: "expanding it again restores the control",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Expand Task log"),
        subject: "Collapse Task log",
        expect: Paints,
    ),
]
