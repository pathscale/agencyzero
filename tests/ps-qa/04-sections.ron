    (
        id: "sections-4",
        group: "sections",
        what: "collapsing a section is acknowledged",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Collapse Task log"),
        subject: "Expand Task log",
        expect: Paints,
    ),
    (
        id: "sections-5",
        group: "sections",
