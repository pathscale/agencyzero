// The composer's three pill menus (Model, Effort, Permission) are the library
// `Dropdown` behind `PillMenu`. `11-composer.ron` proves the Model, Effort and
// Permission triggers change, but only ever names one option per pill, so these
// cover the Effort pill's full open/choose/restore cycle against the renderer.
//
// The gap recorded here was two faults, and only one was the application's.
//
// `press: true` used to fail with "no visible, enabled, sized semantic
// control", which read as the overlay refusing pointer input. It was the
// harness: `press` resolved through a button-only lookup, so a `menuitem`
// could never match whatever the renderer did. Fixed in ps-qa.
//
// What is left is real, and `-by-pointer` below asserts it. With resolution
// working, the press lands on the option, the menu closes, and the value does
// not change - while `click` on that same node commits the selection, and
// `press` on the pill trigger just outside the overlay activates it normally.
// So the pointer path works everywhere except inside the hoisted fixed
// subtree, which is where a person's mouse has to land to choose anything.
//
// Not a dismissal-on-pointerdown defect in the component: the outside-click
// guard was instrumented and made to ignore the menu subtree three different
// ways, and the behaviour did not move. The remaining suspect is hit-testing
// or event dispatch into the hoisted stacking context in the renderer.
[
    (
        id: "pillmenu-effort-opens",
        group: "pillmenu",
        what: "the Effort pill's menu reaches the renderer as an addressable item",
        open: Some("theta theta north indi"),
        hover: None,
        prepare: Some("Effort"),
        settle_after_ms: 600,
        click: None,
        // `menuitem:low` rather than the pill's own name: a name-only check is
        // satisfied by the trigger, which paints whether or not the menu opened.
        subject: "menuitem:low",
        expect: PaintsNamed,
    ),
    (
        id: "pillmenu-effort-selects-low",
        group: "pillmenu",
        what: "choosing low from the Effort pill changes what the trigger reads",
        open: Some("theta theta north indi"),
        hover: None,
        prepare: Some("Effort"),
        settle_after_ms: 600,
        click: Some("menuitem:low"),
        subject: "Effort",
        expect: NameChanges,
    ),
    (
        // The same menu over the physical pointer path, which is what a
        // person's mouse does and what the owner reports as broken. The check
        // above resolves a node id and activates it; this one opens the menu by
        // pressing the trigger and picks a different option by pressing that,
        // both inside one process so the menu is still open when the option is
        // hit. It must differ because the preceding check leaves `low`
        // selected, and selecting `low` again cannot satisfy NameChanges.
        //
        // Worth having as its own check rather than flipping the one above:
        // when these two disagree, the split localises the defect to pointer
        // handling over the hoisted overlay rather than to the menu itself.
        id: "pillmenu-effort-selects-high-by-pointer",
        group: "pillmenu",
        what: "a real pointer press on a menu option commits the selection",
        open: Some("theta theta north indi"),
        hover: None,
        prepare: Some("Effort"),
        prepare_press: true,
        settle_after_ms: 600,
        click: Some("menuitem:high"),
        press: true,
        subject: "Effort",
        expect: NameChanges,
    ),
    (
        id: "pillmenu-effort-restores",
        group: "pillmenu",
        what: "the Effort pill returns to its original value for the rest of the audit",
        open: Some("theta theta north indi"),
        hover: None,
        prepare: Some("Effort"),
        settle_after_ms: 600,
        click: Some("menuitem:medium"),
        subject: "Effort",
        expect: NameChanges,
    ),
    (
        /*
         * Opening one pill menu must close any other that is already open.
         *
         * This is the defect the owner reports as shadows stacking on the
         * composer, and it is not a shadow: the menus are real, both open at
         * once, and they paint over each other. Each popover is a large
         * semi-transparent panel, so two overlapping read as one darker one,
         * and the darkening compounds with every pill visited before the
         * pointer leaves the row.
         *
         * Measured on the running application, deterministic on a clean tree:
         * 0 menu items, press Effort -> 5, press Permission -> 11. Nothing
         * closed. Node count climbs the same way across repeated visits, 454
         * to 498 over eight cycles, and settles only when a mouse-out
         * dismisses everything at once.
         *
         * Named against Effort's own options rather than a count: a count
         * assertion passes for the wrong reason the moment a pill's option
         * list changes length. `Vanishes` rather than `Absent` because a
         * closed menu is legitimately still in the tree with no box.
         */
        id: "pillmenu-opening-one-closes-another",
        group: "pillmenu",
        what: "opening the Permission pill closes the Effort pill's menu",
        open: Some("theta theta north indi"),
        hover: None,
        prepare: Some("Effort"),
        settle_after_ms: 600,
        click: Some("Permission"),
        subject: "menuitem:low",
        expect: Vanishes,
    ),
]
