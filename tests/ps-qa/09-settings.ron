// Settings: the surface that had fourteen controls and no checks at all.
//
// # Menu entry names
//
// Every control here opens a dropdown. Agency's PillMenu supplies an explicit
// accessible name for each entry, so those checks name a concrete option rather
// than accepting any anonymous `menuitem`. The shared language switcher is kept
// as a painted-count assertion until its library entries expose the same name.
//
// # Why PaintsMore and not a count of the tree
//
// The menus are retained. Across four consecutive opens the tree grew
// 32 -> 34 -> 38 -> 43 -> 49 menuitems and never shrank, because a closed menu is
// laid out at 0x0 rather than removed. A tree count therefore rises whether or
// not the control did anything. Painted entries are stable: 0 with every menu
// closed, 6 with one open.
//
// Native macOS file panels remain manual-release checks. Network and process
// actions need explicit status outcomes; they are not credited merely because
// their controls paint.
[
    (
        id: "settings-language-menu",
        group: "settings",
        what: "the language control opens a menu",
        open: Some("Settings"),
        hover: None,
        click: Some("Current language: English"),
        subject: "menuitem",
        expect: PaintsMore,
    ),
    (
        id: "settings-agent-menu",
        group: "settings",
        what: "the default agent control opens a menu",
        open: Some("Settings"),
        hover: None,
        click: Some("Default agent"),
        subject: "menuitem:Claude",
        expect: PaintsNamed,
    ),
    (
        id: "settings-model-menu",
        group: "settings",
        what: "the default model control opens a menu",
        open: Some("Settings"),
        hover: None,
        click: Some("Default model"),
        subject: "menuitem",
        expect: PaintsMore,
    ),
    (
        id: "settings-effort-menu",
        group: "settings",
        what: "the default effort control opens a menu",
        open: Some("Settings"),
        hover: None,
        click: Some("Default effort"),
        subject: "menuitem:medium",
        expect: PaintsNamed,
    ),
    (
        id: "settings-permission-menu",
        group: "settings",
        what: "the default permission control opens a menu",
        open: Some("Settings"),
        hover: None,
        click: Some("Default permission"),
        subject: "menuitem:Read-only",
        expect: PaintsNamed,
    ),
    (
        id: "settings-completed-items-menu",
        group: "settings",
        what: "the completed-items control opens its policy choices",
        open: Some("Settings"),
        hover: None,
        click: Some("Completed items"),
        subject: "menuitem:Mark resolved",
        expect: PaintsNamed,
    ),
    (
        id: "settings-retention-menu",
        group: "settings",
        what: "the finished-item retention control opens its choices",
        open: Some("Settings"),
        hover: None,
        click: Some("Agent-finished retention"),
        subject: "menuitem:1 turn",
        expect: PaintsNamed,
    ),
    (
        id: "settings-context-detail-menu",
        group: "settings",
        what: "the project context-detail control opens its choices",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Per-turn context detail for this project"),
        subject: "menuitem:Auto",
        expect: PaintsNamed,
    ),
    (
        id: "settings-restart-authority-menu",
        group: "settings",
        what: "the agent restart authority opens its choices",
        open: Some("Settings"),
        hover: None,
        click: Some("Agent restart authority"),
        subject: "menuitem:Disabled",
        expect: PaintsNamed,
    ),
    (
        id: "settings-response-verbosity-changes",
        group: "settings",
        what: "the per-project response verbosity control changes its semantic value",
        open: Some("theta theta north indi"),
        hover: None,
        click: None,
        key: Some("Right"),
        key_on: Some("Response verbosity for this project"),
        subject: "Response verbosity for this project",
        expect: ValueChanges,
    ),
    (
        id: "settings-review-prompt-changes",
        group: "settings",
        what: "editing the PR review prompt changes the real text field value",
        open: Some("Settings"),
        hover: None,
        click: None,
        type_into: Some("PR review prompt"),
        text: Some("QA review prompt persistence check"),
        subject: "PR review prompt",
        expect: ValueChanges,
    ),
]
