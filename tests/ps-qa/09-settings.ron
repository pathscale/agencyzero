// Settings: the surface that had fourteen controls and no checks at all.
//
// # Menu entry names
//
// Every control here opens a dropdown. Agency's PillMenu supplies an explicit
// accessible name for each entry, so those checks name a concrete option rather
// than accepting any anonymous `menuitem`. The shared language switcher is kept
// as a painted-count assertion until its library entries expose the same name.
//
// # Why PaintsMore and not a count of the tree
//
// The menus are retained. Across four consecutive opens the tree grew
// 32 -> 34 -> 38 -> 43 -> 49 menuitems and never shrank, because a closed menu is
// laid out at 0x0 rather than removed. A tree count therefore rises whether or
// not the control did anything. Painted entries are stable: 0 with every menu
// closed, 6 with one open.
//
// Native macOS file panels remain manual-release checks. Network and process
// actions need explicit status outcomes; they are not credited merely because
// their controls paint.
[
    (
        id: "settings-model-selects-option",
        group: "settings",
        what: "choosing a different default-model menu item changes the trigger's accessible value",
        open: Some("Settings"),
        prepare: Some("#settings-default-model--trigger"),
        hover: None,
        click: Some("menuitem:Opus (1M context)"),
        subject: "#settings-default-model--trigger",
        expect: NameChanges,
    ),
    (
        id: "settings-model-selects-option-restores",
        group: "settings",
        what: "the default-model trigger returns to the pristine Opus value",
        open: Some("Settings"),
        prepare: Some("#settings-default-model--trigger"),
        hover: None,
        click: Some("menuitem:Opus"),
        subject: "#settings-default-model--trigger",
        expect: NameChanges,
    ),
    (
        id: "settings-effort-selects-option",
        group: "settings",
        what: "choosing medium effort changes the default-effort trigger's accessible value",
        open: Some("Settings"),
        prepare: Some("Default effort"),
        hover: None,
        click: Some("menuitem:medium"),
        subject: "Default effort",
        expect: NameChanges,
        covers: ["button:Default effort:"],
    ),
    (
        id: "settings-permission-selects-option",
        group: "settings",
        what: "choosing Edit changes the default-permission trigger's accessible value",
        open: Some("Settings"),
        prepare: Some("#settings-default-permission--trigger"),
        hover: None,
        click: Some("menuitem:Edit"),
        subject: "#settings-default-permission--trigger",
        expect: NameChanges,
    ),
    (
        id: "settings-completed-items-selects-option",
        group: "settings",
        what: "choosing Mark resolved changes the completed-items trigger's accessible value",
        open: Some("Settings"),
        prepare: Some("#settings-completed-items--trigger"),
        hover: None,
        click: Some("menuitem:Mark resolved"),
        subject: "#settings-completed-items--trigger",
        expect: NameChanges,
    ),
    (
        id: "settings-retention-selects-option",
        group: "settings",
        what: "choosing two turns changes the retention trigger's accessible value",
        open: Some("Settings"),
        prepare: Some("Agent-finished retention"),
        hover: None,
        click: Some("menuitem:2 turns"),
        subject: "Agent-finished retention",
        expect: NameChanges,
        covers: ["button:Agent-finished retention:"],
    ),
    (
        id: "settings-context-detail-selects-option",
        group: "settings",
        what: "choosing Full changes the project context-detail trigger's accessible value",
        open: Some("theta theta north indi"),
        prepare: Some("Per-turn context detail for this project"),
        hover: None,
        click: Some("menuitem:Full"),
        subject: "Per-turn context detail for this project",
        expect: NameChanges,
        covers: ["button:Per-turn context detail for this project:"],
    ),
    (
        id: "settings-restart-authority-selects-option",
        group: "settings",
        what: "choosing restart-only changes the authority trigger without restarting the app",
        open: Some("Settings"),
        prepare: Some("Agent restart authority"),
        hover: None,
        click: Some("menuitem:Restart only"),
        subject: "Agent restart authority",
        expect: NameChanges,
    ),
    (
        id: "settings-response-verbosity-changes",
        group: "settings",
        what: "the per-project response verbosity control changes its semantic value",
        open: Some("theta theta north indi"),
        hover: None,
        click: None,
        // The fixture starts at the maximum. Move toward a value that can
        // change rather than asking a correct slider to exceed its range.
        key: Some("Left"),
        key_on: Some("Response verbosity for this project"),
        subject: "Response verbosity for this project",
        expect: ValueChanges,
    ),
    (
        id: "settings-review-prompt-changes",
        group: "settings",
        what: "editing the PR review prompt changes the real text field value",
        open: Some("Settings"),
        hover: None,
        click: None,
        type_into: Some("PR review prompt"),
        text: Some("QA review prompt persistence check"),
        subject: "PR review prompt",
        expect: ValueChanges,
    ),
    (
        id: "settings-proxy-refresh-completes",
        group: "settings",
        what: "refreshing AgencyProxy status completes a backend round trip",
        open: Some("Settings"),
        hover: None,
        click: Some("Refresh AgencyProxy status"),
        subject: "AgencyProxy refresh generation",
        expect: NameChanges,
    ),
    (
        id: "settings-agent-recheck-completes",
        group: "settings",
        what: "re-checking installed agents completes a backend round trip",
        open: Some("Settings"),
        hover: None,
        click: Some("Re-check"),
        subject: "Agent check generation",
        expect: NameChanges,
    ),
    (
        id: "settings-performance-refreshes",
        group: "settings",
        what: "refreshing internal performance reads a new snapshot",
        open: Some("Settings"),
        hover: None,
        click: Some("Refresh performance measurements"),
        subject: "Performance refresh generation",
        expect: NameChanges,
    ),
    (
        id: "settings-performance-resets",
        group: "settings",
        what: "resetting internal performance clears the collector before rereading it",
        open: Some("Settings"),
        hover: None,
        click: Some("Reset performance measurements"),
        subject: "Performance reset generation",
        expect: NameChanges,
    ),
    (
        id: "settings-use-bundled-disabled-at-default",
        group: "settings",
        what: "the bundled-proxy action is unavailable while bundled AgencyProxy is already selected",
        open: Some("Settings"),
        hover: None,
        click: None,
        subject: "#settings-proxy-use-bundled",
        expect: Disabled,
    ),
    (
        id: "settings-agent-selects-option",
        group: "settings",
        what: "choosing Codex changes the default-agent trigger's accessible value",
        open: Some("Settings"),
        prepare: Some("Default agent"),
        hover: None,
        click: Some("menuitem:Codex"),
        subject: "Default agent",
        expect: NameChanges,
        covers: ["button:Default agent:"],
    ),
]
