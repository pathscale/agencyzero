// The library Select is data-dependent in ordinary use. The panel workflow
// gives chat discovery two disposable provider sessions so the real component
// always has choices and its change/restore behavior cannot silently disappear.
//
// Closed Select options are deliberately unmounted: retaining every option in
// every closed picker was a major node leak. Selection is therefore asserted
// against the persistent trigger's rendered pixels. Its accessible name stays
// descriptive while its visible session label must change after the exact
// option is clicked.
[
    (
        id: "select-session-displays",
        group: "select",
        what: "the session picker shows its current value before anything is chosen",
        open: Some("Settings"),
        hover: None,
        prepare: Some("Choose a session from Codex CLI / IDE"),
        prepare_key: None,
        click: None,
        subject: "button:Choose a session from Codex CLI / IDE",
        expect: PaintsNamed,
        covers: ["#settings-chat-import-codex-trigger"],
    ),
    (
        id: "select-session-changes",
        group: "select",
        what: "choosing another provider session changes what the trigger displays",
        open: Some("Settings"),
        hover: None,
        prepare: Some("Choose a session from Codex CLI / IDE"),
        prepare_key: Some("ArrowDown"),
        click: Some("option:ps-qa older select fixture"),
        subject: "button:Choose a session from Codex CLI / IDE",
        expect: PixelsChange,
    ),
    (
        id: "select-session-restores",
        group: "select",
        what: "the shared Select can restore its original provider session",
        open: Some("Settings"),
        hover: None,
        prepare: Some("Choose a session from Codex CLI / IDE"),
        prepare_key: Some("ArrowDown"),
        click: Some("option:ps-qa newer select fixture"),
        subject: "button:Choose a session from Codex CLI / IDE",
        expect: PixelsChange,
    ),
    (
        id: "select-session-imports-one",
        group: "select",
        what: "importing the selected local transcript opens the copied project",
        open: Some("Settings"),
        hover: None,
        prepare: Some("Choose a session from Codex CLI / IDE"),
        prepare_key: None,
        click: Some("#settings-chat-import-codex-one"),
        subject: "button:ps-qa newer select fixture",
        expect: PaintsNamed,
        covers: ["#settings-chat-import-codex-one"],
    ),
    (
        id: "select-session-imports-all",
        group: "select",
        what: "importing every local transcript reports the completed source count",
        open: Some("Settings"),
        hover: None,
        prepare: Some("Choose a session from Codex CLI / IDE"),
        prepare_key: None,
        click: Some("#settings-chat-import-codex-all"),
        subject: "status:Imported",
        expect: PaintsNamed,
        outcome_timeout_ms: 5000,
        covers: ["#settings-chat-import-codex-all"],
    ),
]
