// The library Select is data-dependent in ordinary use. The panel workflow
// gives chat discovery two disposable provider sessions so the real component
// always has choices and its change/restore behavior cannot silently disappear.
//
// Selection is asserted on the option because its `aria-selected` state is
// derived from the root Select's controlled `value`. AgencyZero must accept
// the change and pass that value back before this state can change. The
// trigger has a fixed descriptive aria-label, so its accessible name is not
// the visible selected value and must not be used as a value assertion.
[
    (
        id: "select-session-displays",
        group: "select",
        what: "the session picker shows its current value before anything is chosen",
        open: Some("Settings"),
        hover: None,
        prepare: Some("Choose a session from Codex CLI / IDE"),
        prepare_key: None,
        click: None,
        subject: "button:Choose a session from Codex CLI / IDE",
        expect: PaintsNamed,
    ),
    (
        id: "select-session-changes",
        group: "select",
        what: "choosing another provider session changes what the trigger displays",
        open: Some("Settings"),
        hover: None,
        prepare: Some("Choose a session from Codex CLI / IDE"),
        prepare_key: Some("ArrowDown"),
        click: Some("option:ps-qa older select fixture"),
        subject: "option:ps-qa older select fixture",
        expect: SelectionChanges,
    ),
    (
        id: "select-session-restores",
        group: "select",
        what: "the shared Select can restore its original provider session",
        open: Some("Settings"),
        hover: None,
        prepare: Some("Choose a session from Codex CLI / IDE"),
        prepare_key: Some("ArrowDown"),
        click: Some("option:ps-qa newer select fixture"),
        subject: "option:ps-qa newer select fixture",
        expect: SelectionChanges,
    ),
]
