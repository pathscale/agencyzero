// Notes are kept across compaction. A changed draft must unlock the explicit
// Save action; geometry alone cannot distinguish the disabled control.
[
    (
        id: "notes-draft-enables-save",
        group: "notes",
        what: "editing durable project notes enables Save",
        open: Some("theta theta north indi"),
        hover: None,
        click: None,
        type_into: Some("Notes kept across compaction"),
        text: Some("qa audit note"),
        subject: "button:Save",
        expect: Enabled,
    ),
    (
        id: "notes-save-persists",
        group: "notes",
        what: "saving durable notes makes the stored value available to forget",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("button:Save"),
        subject: "button:Forget",
        expect: Enabled,
    ),
    (
        id: "notes-forget-clears",
        group: "notes",
        what: "forgetting durable notes clears the stored value",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("button:Forget"),
        subject: "button:Forget",
        expect: Disabled,
    ),
]
