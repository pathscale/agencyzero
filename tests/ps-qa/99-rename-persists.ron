// Opening an editor is not a rename outcome: the harness must enter a value,
// commit it, observe the new accessible project-row control, and restore the
// fixture so this group is safe as a focused preflight before a full audit.
[
    (
        id: "rename-project-persists",
        group: "rename",
        what: "the project pencil accepts and persists a replacement name",
        open: Some("Home"),
        hover: None,
        click: Some("Rename project "),
        type_into: Some("textbox:Rename project "),
        text: Some("qa audit renamed project"),
        key: Some("Enter"),
        subject: "button:Rename project qa audit renamed project",
        expect: PaintsNamed,
    ),
    (
        id: "rename-project-restores",
        group: "rename",
        what: "the persistence check restores the fixture project name",
        open: Some("Home"),
        hover: None,
        click: Some("Rename project qa audit renamed project"),
        type_into: Some("textbox:Rename project qa audit renamed project"),
        text: Some("theta theta north indi"),
        key: Some("Enter"),
        subject: "button:Rename project theta theta north indi",
        expect: PaintsNamed,
    ),
]
