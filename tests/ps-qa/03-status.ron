// The status marker must not destroy the row it belongs to.
//
// Reported as "one click appears to delete items". The cycle deliberately avoids
// the terminal states, so what this pins is that a click does not remove the row.
//
// The row controls are hover-revealed, so a broad family count is invalid here.
// TargetPaints records the exact accessible name selected for the semantic click
// and verifies that exact row still paints afterward.
[
    (
        id: "status-1",
        group: "status",
        what: "clicking the status marker does not remove the row",
        open: Some("theta theta north indi"),
        hover: Some("Change the status of"),
        click: Some("Change the status of"),
        subject: "unused: resolved from the exact click target",
        expect: TargetPaints,
    ),
    (
        id: "status-2",
        group: "status",
        what: "the marker never cycles a row into a terminal state",
        open: Some("theta theta north indi"),
        hover: Some("Change the status of"),
        click: Some("Change the status of"),
        subject: "(Finished)",
        expect: Absent,
    ),
]
