// The status marker must not destroy the row it belongs to.
//
// Reported as "one click appears to delete items". The cycle deliberately avoids
// the terminal states, so what this pins is that a click does not remove the row.
//
// status-1 is known wrong and kept for the record: it counts `Edit ` nodes and
// requires the count to hold, but hovering to reach the marker reveals two more
// row controls, so it reports 19 -> 21 and calls a working marker broken. Fix the
// subject (count the row, or assert the specific item survives) before believing
// either outcome.
[
    (
        id: "status-1",
        group: "status",
        what: "clicking the status marker does not remove the row",
        open: Some("theta theta north indi"),
        hover: Some("Change the status of"),
        click: Some("Change the status of"),
        press: false,
        subject: "Edit ",
        expect: Holds,
        panel_only: true,
    ),
    (
        id: "status-2",
        group: "status",
        what: "the marker never cycles a row into a terminal state",
        open: Some("theta theta north indi"),
        hover: Some("Change the status of"),
        click: Some("Change the status of"),
        press: false,
        subject: "(Finished)",
        expect: Absent,
        panel_only: true,
    ),
]
