// Creating an item is a rendered-order outcome, not merely a successful IPC.
// The title is entered through the textbox's semantic node id and Enter; the
// resulting status controls must preserve creation order inside their shared
// status group, independent of whichever status existing fixture rows carry.
[
    (
        id: "items-default-page",
        group: "items",
        what: "the item list opens with twelve rows rather than a tiny manual page",
        open: Some("theta theta north indi"),
        prepare: Some("Collapse Items"),
        prepare_unless: Some("Expand Items"),
        hover: None,
        click: Some("Expand Items"),
        subject: "listitem:",
        expect_count: Some(12),
        outcome_timeout_ms: 2000,
        expect: Count,
    ),
    (
        id: "items-scroll-expands",
        group: "items",
        what: "scrolling near the item-list edge automatically mounts the next page",
        open: Some("theta theta north indi"),
        hover: None,
        click: None,
        scroll_over: Some("kappa eta north cobalt epsilon north delta east eta zeta beta"),
        scroll_ticks: 4,
        scroll_delta: -300.0,
        subject: "listitem:",
        expect: Grows,
    ),
    (
        id: "items-description-enables-save",
        group: "items",
        what: "editing an item description enables its Save action",
        open: Some("theta theta north indi"),
        hover: Some("Change the status of kappa eta north cobalt epsilon north delta east eta zeta beta"),
        click: Some("Edit the description for kappa eta north cobalt epsilon north delta east eta zeta beta"),
        type_into: Some("Description / sub-items"),
        text: Some("qa audit description"),
        subject: "Save description",
        expect: Enabled,
    ),
    (
        id: "items-description-cancels",
        group: "items",
        what: "Cancel closes the description editor without poisoning later outcomes",
        open: Some("theta theta north indi"),
        hover: None,
        click: None,
        key: Some("Escape"),
        key_on: Some("textbox:Description / sub-items"),
        subject: "Save description",
        expect: Vanishes,
    ),
    (
        id: "items-newest-anchor",
        group: "items",
        what: "a newly created item paints in the rendered list",
        open: Some("theta theta north indi"),
        prepare: None,
        hover: None,
        click: Some("New item"),
        type_into: Some("New item"),
        text: Some("qa audit first new item"),
        key: Some("Enter"),
        subject: "button:Change the status of qa audit first new item",
        expect: PaintsNamed,
        settle_after_ms: 250,
    ),
    (
        id: "items-created-row-reveals",
        group: "items",
        what: "the item filter reveals the exact disposable row without paging duplicate items",
        open: Some("theta theta north indi"),
        hover: None,
        click: None,
        type_into: Some("Filter items"),
        text: Some("qa audit first new item"),
        subject: "button:Change the status of qa audit first new item",
        expect: PaintsNamed,
    ),
    (
        id: "items-created-row-deletes",
        group: "items",
        what: "the exact disposable row created by this run can be deleted",
        open: Some("theta theta north indi"),
        hover: Some("Change the status of qa audit first new item"),
        click: Some("button:Delete qa audit first new item"),
        subject: "button:Delete qa audit first new item",
        expect: Vanishes,
        covers: ["button:Delete *"],
    ),
    (
        id: "items-created-filter-clears",
        group: "items",
        what: "clearing the disposable-row filter restores the ordinary item list",
        open: Some("theta theta north indi"),
        hover: None,
        click: None,
        type_into: Some("Filter items"),
        text: Some(""),
        subject: "button:New item",
        expect: PaintsNamed,
    ),
    (
        id: "items-new-cancel-closes",
        group: "items",
        what: "Escape closes the new-item editor without creating another row",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("New item"),
        key: Some("Escape"),
        key_on: Some("textbox:New item"),
        subject: "button:New item",
        expect: PaintsNamed,
    ),
    (
        id: "items-filter",
        group: "items",
        what: "item filtering removes non-matching rows from the screen",
        open: Some("theta theta north indi"),
        hover: None,
        click: None,
        type_into: Some("Filter items"),
        text: Some("qa-no-item-has-this-name"),
        subject: "Change the status of",
        expect: Vanishes,
    ),
    (
        id: "items-filter-restores",
        group: "items",
        what: "clearing the item filter restores the project rows for later outcomes",
        open: Some("theta theta north indi"),
        hover: None,
        click: None,
        type_into: Some("Filter items"),
        text: Some(""),
        subject: "button:Change the status of kappa eta north cobalt epsilon north delta east eta zeta beta",
        expect: PaintsNamed,
    ),
]
