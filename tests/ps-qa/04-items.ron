// Creating an item is a rendered-order outcome, not merely a successful IPC.
// The title is entered through the textbox's semantic node id and Enter; the
// resulting status control must paint above every older item status control.
[
    (
        id: "items-newest-first",
        group: "items",
        what: "a newly created item appears at the top of the item list",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("New item"),
        type_into: Some("New item"),
        text: Some("qa audit newest"),
        key: Some("Enter"),
        compare: Some("Change the status of"),
        subject: "Change the status of qa audit newest",
        expect: Above,
    ),
    (
        id: "items-description-enables-save",
        group: "items",
        what: "editing an item description enables its Save action",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Edit the description for"),
        type_into: Some("Description / sub-items"),
        text: Some("qa audit description"),
        subject: "Save description",
        expect: Enabled,
    ),
    (
        id: "items-new-cancel-closes",
        group: "items",
        what: "Escape closes the new-item editor without creating another row",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("New item"),
        key: Some("Escape"),
        key_on: Some("textbox:New item"),
        subject: "button:New item",
        expect: PaintsNamed,
    ),
    (
        id: "items-filter",
        group: "items",
        what: "item filtering removes non-matching rows from the screen",
        open: Some("theta theta north indi"),
        hover: None,
        click: None,
        type_into: Some("Filter items"),
        text: Some("qa-no-item-has-this-name"),
        subject: "Change the status of",
        expect: Vanishes,
    ),
]
