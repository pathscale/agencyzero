// Shell and list chrome must expose the inverse control after each toggle.
// These assertions use the accessible name, so a preference write without a
// rendered response stays red.
[
    (
        id: "chrome-hide-project-sidebar",
        group: "chrome",
        what: "the project sidebar can be hidden",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Hide the project sidebar"),
        subject: "Show the project sidebar",
        expect: Paints,
    ),
    (
        id: "chrome-show-project-sidebar",
        group: "chrome",
        what: "the project sidebar can be restored",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Show the project sidebar"),
        subject: "Hide the project sidebar",
        expect: Paints,
    ),
    (
        id: "chrome-project-sort-time",
        group: "chrome",
        what: "the project panel changes from status order to time order",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Sort items by status; choose time"),
        subject: "Sort items by time; choose status",
        expect: Paints,
    ),
    (
        id: "chrome-project-sort-status",
        group: "chrome",
        what: "the project panel restores status order",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Sort items by time; choose status"),
        subject: "Sort items by status; choose time",
        expect: Paints,
    ),
    (
        id: "chrome-project-sort-direction",
        group: "chrome",
        what: "the project panel reverses its item sort direction",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Sort descending"),
        subject: "Sort ascending",
        expect: Paints,
    ),
    (
        id: "chrome-project-sort-restores",
        group: "chrome",
        what: "the project panel restores its item sort direction",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Sort ascending"),
        subject: "Sort descending",
        expect: Paints,
    ),
    (
        id: "chrome-home-sort-turns",
        group: "chrome",
        what: "Home changes from time order to turn-count order",
        open: Some("Home"),
        hover: None,
        click: Some("Sort Home by time; choose turns"),
        subject: "Sort Home by turns; choose status",
        expect: Paints,
    ),
    (
        id: "chrome-home-sort-status",
        group: "chrome",
        what: "Home changes from turn-count order to status order",
        open: Some("Home"),
        hover: None,
        click: Some("Sort Home by turns; choose status"),
        subject: "Sort Home by status; choose time",
        expect: Paints,
    ),
    (
        id: "chrome-home-sort-time",
        group: "chrome",
        what: "Home completes the cycle back to time order",
        open: Some("Home"),
        hover: None,
        click: Some("Sort Home by status; choose time"),
        subject: "Sort Home by time; choose turns",
        expect: Paints,
    ),
    (
        id: "chrome-home-sort-direction",
        group: "chrome",
        what: "Home reverses its project sort direction",
        open: Some("Home"),
        hover: None,
        click: Some("Sort ascending"),
        subject: "Sort descending",
        expect: Paints,
    ),
    (
        id: "chrome-home-sort-restores",
        group: "chrome",
        what: "Home can restore its project sort direction",
        open: Some("Home"),
        hover: None,
        click: Some("Sort descending"),
        subject: "Sort ascending",
        expect: Paints,
    ),
]
