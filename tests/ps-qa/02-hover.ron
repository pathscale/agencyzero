// Project-row actions mount for the active row only. Hover the row's named
// status control first, then drive the revealed action by semantic node id.
// Test what the controls actually promise: ordering, editing and deletion.
[
    (
        id: "row-action-moves-up",
        group: "row-actions",
        what: "Move up places the exact middle item above its previous sibling",
        open: Some("theta theta north indi"),
        hover: Some("Change the status of kappa eta north cobalt epsilon north delta east eta zeta beta"),
        click: Some("button:Move kappa eta north cobalt epsilon north delta east eta zeta beta up"),
        compare: Some("Change the status of gamma east north gamma lambda indigo kappa south epsilon beta south lambd"),
        subject: "Change the status of kappa eta north cobalt epsilon north delta east eta zeta beta",
        expect: Above,
        covers: ["button:Move *"],
        settle_after_ms: 1800,
    ),
    (
        id: "row-action-moves-down",
        group: "row-actions",
        what: "Move down restores the exact item below its previous sibling",
        open: Some("theta theta north indi"),
        hover: Some("Change the status of kappa eta north cobalt epsilon north delta east eta zeta beta"),
        click: Some("button:Move kappa eta north cobalt epsilon north delta east eta zeta beta down"),
        compare: Some("Change the status of kappa eta north cobalt epsilon north delta east eta zeta beta"),
        subject: "Change the status of gamma east north gamma lambda indigo kappa south epsilon beta south lambd",
        expect: Above,
        settle_after_ms: 1800,
    ),
    (
        id: "row-action-edit-opens",
        group: "row-actions",
        what: "the project-row pencil opens the exact inline editor",
        open: Some("theta theta north indi"),
        hover: Some("Change the status of kappa eta north cobalt epsilon north delta east eta zeta beta"),
        click: Some("button:Edit kappa eta north cobalt epsilon north delta east eta zeta beta"),
        subject: "textbox:Edit kappa eta north cobalt epsilon north delta east eta zeta beta",
        expect: PaintsNamed,
        covers: ["button:Edit *"],
    ),
    (
        id: "row-action-edit-persists",
        group: "row-actions",
        what: "the project-row editor saves a replacement title on Enter",
        open: None,
        hover: None,
        click: None,
        type_into: Some("textbox:Edit kappa eta north cobalt epsilon north delta east eta zeta beta"),
        text: Some("qa audit project item"),
        key: Some("Enter"),
        key_on: Some("textbox:Edit kappa eta north cobalt epsilon north delta east eta zeta beta"),
        subject: "button:Change the status of qa audit project item",
        expect: PaintsNamed,
        settle_after_ms: 1800,
    ),
    (
        id: "row-action-edit-restores",
        group: "row-actions",
        what: "the project-row editor restores its fixture title for later outcomes",
        open: Some("theta theta north indi"),
        hover: Some("Change the status of qa audit project item"),
        click: Some("button:Edit qa audit project item"),
        type_into: Some("textbox:Edit qa audit project item"),
        text: Some("kappa eta north cobalt epsilon north delta east eta zeta beta"),
        key: Some("Enter"),
        key_on: Some("textbox:Edit qa audit project item"),
        subject: "button:Change the status of kappa eta north cobalt epsilon north delta east eta zeta beta",
        expect: PaintsNamed,
        settle_after_ms: 1800,
    ),
]
