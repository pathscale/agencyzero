// Project-row actions mount for the active row only. Hover the row's named
// status control first, then drive the revealed action by semantic node id.
// Test what the controls actually promise: ordering, editing and deletion.
[
    (
        id: "row-action-moves-up",
        group: "row-actions",
        what: "Move up places the exact middle item above its previous sibling",
        open: Some("theta theta north indi"),
        hover: Some("Change the status of iota beta zeta delta north cobalt epsilon omega lambda epsilon"),
        click: Some("button:Move iota beta zeta delta north cobalt epsilon omega lambda epsilon up"),
        compare: Some("Change the status of amber omega zeta east amber zeta cobalt omega north beta sigma amber amber om"),
        subject: "Change the status of iota beta zeta delta north cobalt epsilon omega lambda epsilon",
        expect: Above,
        covers: ["button:Move *"],
    ),
    (
        id: "row-action-moves-down",
        group: "row-actions",
        what: "Move down restores the exact item below its previous sibling",
        open: Some("theta theta north indi"),
        hover: Some("Change the status of iota beta zeta delta north cobalt epsilon omega lambda epsilon"),
        click: Some("button:Move iota beta zeta delta north cobalt epsilon omega lambda epsilon down"),
        compare: Some("Change the status of iota beta zeta delta north cobalt epsilon omega lambda epsilon"),
        subject: "Change the status of amber omega zeta east amber zeta cobalt omega north beta sigma amber amber om",
        expect: Above,
    ),
    (
        id: "row-action-edit-opens",
        group: "row-actions",
        what: "the project-row pencil opens the exact inline editor",
        open: Some("theta theta north indi"),
        hover: Some("Change the status of iota beta zeta delta north cobalt epsilon omega lambda epsilon"),
        click: Some("button:Edit iota beta zeta delta north cobalt epsilon omega lambda epsilon"),
        subject: "textbox:Edit iota beta zeta delta north cobalt epsilon omega lambda epsilon",
        expect: PaintsNamed,
        covers: ["button:Edit *"],
    ),
    (
        id: "row-action-edit-persists",
        group: "row-actions",
        what: "the project-row editor saves a replacement title on Enter",
        open: None,
        hover: None,
        click: None,
        type_into: Some("textbox:Edit iota beta zeta delta north cobalt epsilon omega lambda epsilon"),
        text: Some("qa audit project item"),
        key: Some("Enter"),
        key_on: Some("textbox:Edit iota beta zeta delta north cobalt epsilon omega lambda epsilon"),
        subject: "button:Edit qa audit project item",
        expect: PaintsNamed,
    ),
    (
        id: "row-action-delete-removes",
        group: "row-actions",
        what: "the project-row delete control removes the exact disposable item",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("button:Delete qa audit project item"),
        subject: "button:Delete qa audit project item",
        expect: Vanishes,
        covers: ["button:Delete *"],
    ),
]
