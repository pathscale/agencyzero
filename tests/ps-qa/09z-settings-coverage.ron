// Outcome contracts for the Settings controls materialized by semantic search.
//
// Repeated model and theme rows are one component rendered from an array. Each
// family check drives one exact named node, while `covers` declares the
// identical accessible contract shared by its siblings. It never changes how
// the action is resolved or how the outcome is judged.
[
    (
        id: "settings-model-offer-changes",
        group: "settings",
        what: "the repeated model-offer checkboxes change their exact semantic value",
        open: Some("Settings"),
        hover: None,
        click: Some("Offer Default"),
        covers: ["checkbox:Offer "],
        subject: "Offer Default",
        expect: ValueChanges,
    ),
    (
        id: "settings-model-default-changes",
        group: "settings",
        what: "making an offered model the default removes that row's make-default action",
        open: Some("Settings"),
        hover: None,
        click: Some("Make Default the default"),
        covers: ["button:Make "],
        subject: "Make Default the default",
        expect: Vanishes,
    ),
    (
        id: "settings-model-refresh-completes",
        group: "settings",
        what: "re-reading models completes the CLI discovery round trip",
        open: Some("Settings"),
        hover: None,
        click: Some("Re-read from the CLIs"),
        subject: "Model refresh generation",
        expect: NameChanges,
    ),
    (
        id: "settings-task-manager-model-disabled-without-options",
        group: "settings",
        what: "the task-manager model control is unavailable without an alternative model",
        open: Some("Settings"),
        hover: None,
        click: None,
        subject: "Task manager model",
        expect: Disabled,
    ),
    (
        id: "settings-task-manager-effort-selects-option",
        group: "settings",
        what: "choosing medium changes the task-manager effort trigger's accessible value",
        open: Some("Settings"),
        prepare: Some("Task manager effort"),
        hover: None,
        click: Some("menuitem:medium"),
        subject: "Task manager effort",
        expect: NameChanges,
    ),
    (
        id: "settings-task-manager-permission-selects-option",
        group: "settings",
        what: "choosing Edit changes the task-manager permission trigger's accessible value",
        open: Some("Settings"),
        prepare: Some("Task manager permission"),
        hover: None,
        click: Some("menuitem:Edit"),
        subject: "Task manager permission",
        expect: NameChanges,
    ),
    (
        id: "settings-task-manager-agent-selects-option",
        group: "settings",
        what: "choosing Claude changes the task-manager agent trigger's accessible value",
        open: Some("Settings"),
        prepare: Some("Task manager agent"),
        hover: None,
        click: Some("menuitem:Claude"),
        subject: "Task manager agent",
        expect: NameChanges,
        covers: ["#settings-task-manager-agent--trigger"],
    ),
    (
        id: "settings-task-manager-directory-adds",
        group: "settings",
        what: "a task-manager directory entered by name paints in the saved list",
        open: Some("Settings"),
        hover: None,
        click: None,
        type_into: Some("Add a task manager directory"),
        text: Some("/tmp/qa-task-manager-dir"),
        key: Some("Enter"),
        subject: "/tmp/qa-task-manager-dir",
        expect: Paints,
    ),
    (
        id: "dirs-project-working-directory-adds",
        group: "dirs",
        what: "a typed project working directory survives Enter and paints in the real list",
        open: Some("theta theta north indi"),
        prepare: Some("Add dir"),
        hover: None,
        click: None,
        type_into: Some("Working directory path"),
        text: Some("/tmp/qa-project-dir"),
        key: Some("Enter"),
        subject: "/tmp/qa-project-dir",
        expect: Paints,
    ),
    (
        id: "dirs-project-working-directory-restores",
        group: "dirs",
        what: "the rendered project directory row can be removed to restore the fixture",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Remove /tmp/qa-project-dir"),
        subject: "/tmp/qa-project-dir",
        expect: Vanishes,
    ),
    (
        id: "settings-cost-warning-threshold-changes",
        group: "settings",
        what: "the projected-turn warning threshold changes through its semantic slider",
        open: Some("Settings"),
        hover: None,
        click: None,
        key: Some("Right"),
        key_on: Some("Projected turn warning threshold"),
        subject: "Projected turn warning threshold",
        expect: ValueChanges,
    ),
    (
        id: "settings-cost-warnings-toggle",
        group: "settings",
        what: "projected-cost warnings can be toggled",
        open: Some("Settings"),
        hover: None,
        click: Some("Show projected-cost warnings"),
        subject: "Show projected-cost warnings",
        expect: ValueChanges,
    ),
    (
        id: "settings-update-check-completes",
        group: "settings",
        what: "checking for an update completes its backend round trip",
        open: Some("Settings"),
        hover: None,
        click: Some("Check for update"),
        subject: "Update check generation",
        expect: NameChanges,
        outcome_timeout_ms: 2000,
    ),
    (
        id: "settings-workspace-root-creates",
        group: "dialog",
        what: "the workspace created by the setup dialog no longer offers a duplicate create action",
