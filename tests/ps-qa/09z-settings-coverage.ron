// Outcome contracts for the Settings controls materialized by semantic search.
//
// Repeated model and theme rows are one component rendered from an array. Each
// family check drives one exact named node, while `covers` declares the
// identical accessible contract shared by its siblings. It never changes how
// the action is resolved or how the outcome is judged.
[
    (
        id: "settings-model-offer-changes",
        group: "settings",
        what: "the repeated model-offer checkboxes change their exact semantic value",
        open: Some("Settings"),
        hover: None,
        click: Some("Offer Default"),
        covers: ["checkbox:Offer "],
        subject: "Offer Default",
        expect: ValueChanges,
    ),
    (
        id: "settings-model-default-changes",
        group: "settings",
        what: "making an offered model the default removes that row's make-default action",
        open: Some("Settings"),
        hover: None,
        click: Some("Make Default the default"),
        covers: ["button:Make "],
        subject: "Make Default the default",
        expect: Vanishes,
    ),
    (
        id: "settings-model-refresh-completes",
        group: "settings",
        what: "re-reading models completes the CLI discovery round trip",
        open: Some("Settings"),
        hover: None,
        click: Some("Re-read from the CLIs"),
        subject: "Model refresh generation",
        expect: NameChanges,
    ),
    (
        id: "settings-task-manager-agent-menu",
        group: "settings",
        what: "the task-manager agent control opens its choices",
        open: Some("Settings"),
        hover: None,
        click: Some("Task manager agent"),
        subject: "menuitem:Claude",
        expect: PaintsNamed,
    ),
    (
        id: "settings-task-manager-directory-adds",
        group: "settings",
        what: "a task-manager directory entered by name paints in the saved list",
        open: Some("Settings"),
        hover: None,
        click: None,
        type_into: Some("Add a task manager directory"),
        text: Some("/tmp/qa-task-manager-dir"),
        key: Some("Enter"),
        subject: "/tmp/qa-task-manager-dir",
        expect: Paints,
    ),
    (
        id: "settings-cost-warning-threshold-changes",
        group: "settings",
        what: "the projected-turn warning threshold changes through its semantic slider",
        open: Some("Settings"),
        hover: None,
        click: None,
        key: Some("Right"),
        key_on: Some("Projected turn warning threshold"),
        subject: "Projected turn warning threshold",
        expect: ValueChanges,
    ),
    (
        id: "settings-cost-warnings-toggle",
        group: "settings",
        what: "projected-cost warnings can be toggled",
        open: Some("Settings"),
        hover: None,
        click: Some("Show projected-cost warnings"),
        subject: "Show projected-cost warnings",
        expect: ValueChanges,
    ),
    (
        id: "settings-update-check-completes",
        group: "settings",
        what: "checking for an update completes its backend round trip",
        open: Some("Settings"),
        hover: None,
        click: Some("Check for update"),
        subject: "Update check generation",
        expect: NameChanges,
    ),
    (
        id: "settings-workspace-root-creates",
        group: "settings",
        what: "creating the configured workspace root removes the create action",
        open: Some("Settings"),
        hover: None,
        click: Some("Create it"),
        subject: "Create it",
        expect: Vanishes,
    ),
    (
        id: "settings-snapshot-completes",
        group: "settings",
        what: "taking a store snapshot completes the backend write",
        open: Some("Settings"),
        hover: None,
        click: Some("Take snapshot"),
        subject: "Snapshot generation",
        expect: NameChanges,
    ),
    (
        id: "settings-study-toggle",
        group: "settings",
        what: "the local PromptSyntax deployment study can be toggled",
        open: Some("Settings"),
        hover: None,
        click: Some("PS deployment study"),
        subject: "PS deployment study",
        expect: ValueChanges,
    ),
    (
        id: "settings-moderator-default-toggle",
        group: "settings",
        what: "the default moderator setting can be toggled",
        open: Some("Settings"),
        hover: None,
        click: Some("Moderator enabled by default"),
        subject: "Moderator enabled by default",
        expect: ValueChanges,
    ),
    (
        id: "settings-confine-toggle",
        group: "settings",
        what: "working-directory confinement can be toggled",
        open: Some("Settings"),
        hover: None,
        click: Some("Confine tool calls to the working directories"),
        subject: "Confine tool calls to the working directories",
        expect: ValueChanges,
    ),
    (
        id: "settings-check-hold-toggle",
        group: "settings",
        what: "CHECK hold behaviour can be toggled",
        open: Some("Settings"),
        hover: None,
        click: Some("CHECK hold behaviour"),
        subject: "CHECK hold behaviour",
        expect: ValueChanges,
    ),
    (
        id: "settings-critical-hold-toggle",
        group: "settings",
        what: "CRITICAL hold behaviour can be toggled",
        open: Some("Settings"),
        hover: None,
        click: Some("CRITICAL hold behaviour"),
        subject: "CRITICAL hold behaviour",
        expect: ValueChanges,
    ),
    (
        id: "settings-notify-hold-toggle",
        group: "settings",
        what: "hold notifications can be toggled",
        open: Some("Settings"),
        hover: None,
        click: Some("Notify on a hold"),
        subject: "Notify on a hold",
        expect: ValueChanges,
    ),
    (
        id: "settings-notify-run-toggle",
        group: "settings",
        what: "run-finished notifications can be toggled",
        open: Some("Settings"),
        hover: None,
        click: Some("Notify when a run finishes"),
        subject: "Notify when a run finishes",
        expect: ValueChanges,
    ),
    (
        id: "settings-notify-task-toggle",
        group: "settings",
        what: "task-failure notifications can be toggled",
        open: Some("Settings"),
        hover: None,
        click: Some("Notify when a task fails"),
        subject: "Notify when a task fails",
        expect: ValueChanges,
    ),
    (
        id: "settings-notify-rate-limit-toggle",
        group: "settings",
        what: "rate-limit notifications can be toggled",
        open: Some("Settings"),
        hover: None,
        click: Some("Notify when rate limited"),
        subject: "Notify when rate limited",
        expect: ValueChanges,
    ),
    (
        id: "settings-sound-toggle",
        group: "settings",
        what: "notification sound can be toggled",
        open: Some("Settings"),
        hover: None,
        click: Some("Play a sound"),
        subject: "Play a sound",
        expect: ValueChanges,
    ),
    (
        id: "settings-environment-policy-menu",
        group: "settings",
        what: "the environment policy opens its explicit choices",
        open: Some("Settings"),
        hover: None,
        click: Some("Environment policy"),
        subject: "menuitem:Inherit",
        expect: PaintsNamed,
    ),
    (
        id: "settings-forward-proxy-toggle",
        group: "settings",
        what: "forwarding proxy and custom-CA variables can be toggled",
        open: Some("Settings"),
        hover: None,
        click: Some("Forward proxy and custom-CA variables"),
        subject: "Forward proxy and custom-CA variables",
        expect: ValueChanges,
    ),
    (
        id: "settings-use-default-disabled",
        group: "settings",
        what: "the inherited-default action is disabled while no override needs clearing",
        open: Some("Settings"),
        hover: None,
        click: None,
        subject: "Use the default",
        expect: Disabled,
    ),
    (
        id: "settings-study-delete-disabled-without-data",
        group: "settings",
        what: "study-data deletion is unavailable when there is nothing eligible to delete",
        open: Some("Settings"),
        hover: None,
        click: None,
        subject: "button:Delete data",
        expect: Disabled,
    ),
]
