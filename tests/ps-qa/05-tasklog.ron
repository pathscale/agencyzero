// The task log renders its per-row controls and can page backwards.
//
// Both regressed once with the unit suite green: the log rendered upside down,
// and it could not page past its first fetch.
[
    (
        id: "tasklog-1",
        group: "tasklog",
        what: "task log rows render their per-row copy control",
        open: Some("theta theta north indi"),
        hover: None, click: None,
        subject: "Copy this task-log entry",
        expect: Paints,
    ),
    (
        id: "tasklog-copy-entry",
        group: "tasklog",
        what: "copying a task-log row reports that the clipboard write succeeded",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Copy this task-log entry"),
        subject: "Copied task-log entry",
        expect: Paints,
    ),
    (
        id: "tasklog-copy-all",
        group: "tasklog",
        what: "copying the visible task log reports that the clipboard write succeeded",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Copy task log"),
        subject: "Copied task log",
        expect: Paints,
    ),
    (
        id: "tasklog-expand-command",
        group: "tasklog",
        what: "a truncated task-log command can be expanded",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Show the whole command"),
        subject: "Hide the whole command",
        expect: Paints,
    ),
    (
        id: "tasklog-collapse-command",
        group: "tasklog",
        what: "an expanded task-log command can be collapsed",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Hide the whole command"),
        subject: "Show the whole command",
        expect: Paints,
    ),
    (
        id: "tasklog-collapse-items-for-paging",
        group: "tasklog",
        what: "collapsing Items brings the task-log pager into the visible panel",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Collapse Items"),
        subject: "Expand Items",
        expect: Paints,
    ),
    (
        id: "tasklog-collapse-running-for-paging",
        group: "tasklog",
        what: "collapsing Running leaves the task-log pager reachable without coordinates",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Collapse Running"),
        subject: "Expand Running",
        expect: Paints,
    ),
    // `PaintsMore`, not `Grows`. `Grows` counts tree membership, so a page of
    // rows that mounted and then laid out at 0x0 satisfies it: the log would
    // look paged and show the owner nothing. Measured both ways on a working
    // build; this is the stronger one that still passes.
    (
        id: "tasklog-2",
        group: "tasklog",
        what: "revealing earlier entries adds rows",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Show 20 earlier"),
        subject: "Copy this task-log entry",
        expect: PaintsMore,
    ),
    (
        id: "tasklog-clear",
        group: "tasklog",
        what: "clearing the task log removes its rendered rows",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Clear"),
        subject: "Copy this task-log entry",
        expect: Vanishes,
    ),
]
