// The task log renders its per-row controls and can page backwards.
//
// Both regressed once with the unit suite green: the log rendered upside down,
// and it could not page past its first fetch.
[
    (
        id: "agent-io-expands",
        group: "agent-io",
        what: "the agent I/O viewport expands without remounting the panel",
        open: Some("theta theta north indi"),
        reveal_before_capture: Some("Agent I/O"),
        hover: None,
        click: Some("button:Agent I/O: Expand"),
        subject: "button:Agent I/O: Shrink",
        expect: PaintsNamed,
    ),
    (
        id: "agent-io-shrinks",
        group: "agent-io",
        what: "the expanded agent I/O viewport returns to its compact height",
        open: Some("theta theta north indi"),
        reveal_before_capture: Some("Agent I/O"),
        hover: None,
        click: Some("button:Agent I/O: Shrink"),
        subject: "button:Agent I/O: Expand",
        expect: PaintsNamed,
    ),
    (
        id: "agent-io-copies-all",
        group: "agent-io",
        what: "copying every agent I/O entry reports clipboard success",
        open: Some("theta theta north indi"),
        reveal_before_capture: Some("Agent I/O"),
        hover: None,
        click: Some("button:Copy all"),
        subject: "button:Copied all",
        expect: PaintsNamed,
    ),
    (
        id: "tasklog-1",
        group: "tasklog",
        what: "task log rows render their primary command control",
        open: Some("theta theta north indi"),
        hover: None, click: None,
        subject: "Show the whole command",
        expect: Paints,
    ),
    (
        id: "tasklog-copy-entry",
        group: "tasklog",
        what: "copying a task-log row reports that the clipboard write succeeded",
        open: Some("theta theta north indi"),
        // The per-entry copy action is intentionally a row-hover affordance.
        // Keep the row hovered so the check drives the same control a person
        // can actually see. Expanding first replaces the hovered affordance
        // and needlessly races the per-entry copy action against that remount.
        hover: Some("@task-log-entry"),
        click: Some("Copy this task-log entry"),
        subject: "Copied task-log entry",
        expect: Paints,
    ),
    (
        id: "tasklog-copy-all",
        group: "tasklog",
        what: "copying the visible task log reports that the clipboard write succeeded",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Copy task log"),
        subject: "Copied task log",
        expect: Paints,
    ),
    (
        id: "tasklog-expand-command",
        group: "tasklog",
        what: "a truncated task-log command can be expanded",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Show the whole command"),
        subject: "Hide the whole command",
        expect: Paints,
    ),
    (
        id: "tasklog-collapse-command",
        group: "tasklog",
        what: "an expanded task-log command can be collapsed",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Hide the whole command"),
        subject: "Show the whole command",
        expect: Paints,
    ),
    (
        id: "tasklog-collapse-items-for-paging",
        group: "tasklog",
        what: "collapsing Items brings the task-log pager into the visible panel",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Collapse Items"),
        subject: "Expand Items",
        expect: Paints,
    ),
    (
        id: "tasklog-collapse-running-for-paging",
        group: "tasklog",
        what: "collapsing Running leaves the task-log pager reachable without coordinates",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Collapse Running"),
        subject: "Expand Running",
        expect: Paints,
    ),
    // `PaintsMore`, not `Grows`. `Grows` counts tree membership, so a page of
    // rows that mounted and then laid out at 0x0 satisfies it: the log would
    // look paged and show the owner nothing. Measured both ways on a working
    // build; this is the stronger one that still passes.
    (
        id: "tasklog-2",
        group: "tasklog",
        what: "revealing earlier entries adds rows",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Show 6 earlier"),
        subject: "Show the whole command",
        expect: PaintsMore,
        covers: ["button:Show * earlier"],
    ),
    (
        id: "tasklog-restore-running",
        group: "tasklog",
        what: "task-log coverage restores the Running panel for later groups",
        open: Some("theta theta north indi"),
        prepare: Some("Expand Running"),
        prepare_unless: Some("Collapse Running"),
        hover: None,
        click: None,
        subject: "Collapse Running",
        expect: Paints,
    ),
    (
        id: "tasklog-restore-items",
        group: "tasklog",
        what: "task-log coverage restores the Items panel for later groups",
        open: Some("theta theta north indi"),
        prepare: Some("Expand Items"),
        prepare_unless: Some("Collapse Items"),
        hover: None,
        click: None,
        subject: "Collapse Items",
        expect: Paints,
    ),
]
