// A destructive control asks before it destroys.
[
    (
        id: "delete-asks-first",
        group: "delete",
        what: "deleting a project asks before it removes anything",
        open: Some("Home"),
        hover: None,
        click: Some("Delete project e756"),
        // Assert the unique semantic confirmation control, not nearby prose.
        // Plain text is not guaranteed to become an accessibility node.
        subject: "Confirm delete: e756",
        expect: Paints,
    ),
    (
        id: "delete-cancel-restores-row",
        group: "delete",
        what: "Cancel exits project deletion without removing the row",
        // The preceding check leaves this confirmation open. Re-opening the
        // delete control while a modal owns focus is neither possible nor part
        // of Cancel's contract.
        open: None,
        hover: None,
        click: Some("Cancel"),
        subject: "Confirm delete: e756",
        expect: Vanishes,
    ),
]
