// A destructive control asks before it destroys.
[
    (
        id: "delete-asks-first",
        group: "delete",
        what: "deleting a project asks before it removes anything",
        open: Some("Home"),
        hover: None,
        click: Some("Delete e756"),
        // The confirmation appears *in* the row, so the row's own name grows the
        // prompt. Absence of that is a delete that fired.
        subject: "Delete?",
        expect: Paints,
        panel_only: false,
    ),
]
