// A destructive control asks before it destroys.
[
    (
        id: "delete-asks-first",
        group: "delete",
        what: "deleting a project asks before it removes anything",
        open: Some("Home"),
        hover: None,
        click: Some("Delete e756"),
        // Assert the unique semantic confirmation control, not nearby prose.
        // Plain text is not guaranteed to become an accessibility node.
        subject: "Confirm delete: e756",
        expect: Paints,
    ),
]
