// A destructive control asks before it destroys.
[
    (
        id: "delete-project-search",
        group: "delete",
        destructive: true,
        what: "Home search exposes the exact disposable project before destructive controls are tested",
        open: Some("Home"),
        hover: None,
        click: None,
        type_into: Some("Search projects and items"),
        text: Some("e756"),
        subject: "button:Open project e756",
        expect: PaintsNamed,
    ),
    (
        id: "delete-asks-first",
        group: "delete",
        destructive: true,
        what: "deleting a project asks before it removes anything",
        open: Some("Home"),
        hover: Some("Open project e756"),
        click: Some("Delete project e756"),
        // The standard dialog's escape path is painted immediately. The
        // confirm button can be outside the virtualized Home viewport until it
        // is scrolled for the final destructive action below.
        subject: "button:Cancel",
        expect: Paints,
        covers: ["button:Delete project *"],
    ),
    (
        id: "delete-cancel-restores-row",
        group: "delete",
        destructive: true,
        what: "Cancel exits project deletion without removing the row",
        // The preceding check leaves this confirmation open. Re-opening the
        // delete control while a modal owns focus is neither possible nor part
        // of Cancel's contract.
        open: None,
        hover: None,
        click: Some("Cancel"),
        subject: "button:Cancel",
        expect: Vanishes,
    ),
    (
        id: "delete-confirm-asks-again",
        group: "delete",
        destructive: true,
        what: "the disposable project can enter confirmation again after Cancel",
        open: Some("Home"),
        hover: Some("Open project e756"),
        click: Some("Delete project e756"),
        subject: "button:Cancel",
        expect: Paints,
    ),
    (
        id: "delete-confirm-removes-project",
        group: "delete",
        destructive: true,
        what: "confirming project deletion removes the exact disposable project row",
        open: None,
        hover: None,
        click: Some("Confirm delete: e756"),
        subject: "Open project e756",
        expect: Vanishes,
    ),
    (
        id: "delete-search-clears",
        group: "delete",
        destructive: true,
        what: "the destructive fixture leaves Home search ready for later behavior checks",
        open: Some("Home"),
        hover: None,
        click: None,
        type_into: Some("Search projects and items"),
        text: Some(""),
        subject: "button:New Project",
        expect: PaintsNamed,
    ),
]
