// A dialog opens *and* can be dismissed.
//
// The failure this exists for: the fork dialog's root was re-parented with
// document.body.append, the engine reallocated the slot, and the node that
// painted was no longer the node the handlers were bound to. Every exit was
// inert, with no error, and 68 of that surface's 84 controls sat unreachable
// behind it.
//
// `Vanishes` rather than `Absent`: a dismissed dialog is still in the tree at
// 0x0, so asking for absence reports a working control as broken. 1344x900 while
// open, nothing once closed.
[
    (
        id: "dialog-opens",
        group: "dialog",
        what: "the fork dialog opens when its control is pressed",
        open: Some("Home"),
        hover: None,
        click: Some("button:Fork iota beta zeta delta north cobalt epsilon omega lambda epsilon into a fresh chat"),
        subject: "Start fork",
        expect: Paints,
        covers: ["button:Fork "],
    ),
    (
        id: "dialog-cancel-dismisses",
        group: "dialog",
        what: "the fork dialog's Cancel actually dismisses it",
        open: Some("Home"),
        hover: None,
        click: Some("Cancel"),
        subject: "Start fork",
        expect: Vanishes,
    ),
    (
        id: "dialog-escape-dismisses",
        group: "dialog",
        what: "the shared anchored dialog closes on Escape",
        open: Some("button:Fork iota beta zeta delta north cobalt epsilon omega lambda epsilon into a fresh chat"),
        hover: None,
        click: None,
        type_into: None,
        text: None,
        key: Some("Escape"),
        key_on: Some("button:Start fork"),
        compare: None,
        subject: "Start fork",
        expect: Vanishes,
    ),
    (
        id: "dialog-edits-fork-context",
        group: "dialog-fork",
        what: "the fork dialog accepts replacement item context before starting",
        open: Some("button:Fork iota beta zeta delta north cobalt epsilon omega lambda epsilon into a fresh chat"),
        hover: None,
        click: None,
        type_into: Some("textbox:Description / sub-items"),
        text: Some("Preserve the owner decision and run the focused tests."),
        subject: "textbox:Description / sub-items",
        expect: ValueChanges,
    ),
    (
        id: "dialog-starts-fork",
        group: "dialog-fork",
        what: "starting a fork closes the dialog and opens a new project tab",
        open: Some("button:Fork iota beta zeta delta north cobalt epsilon omega lambda epsilon into a fresh chat"),
        hover: None,
        click: Some("Start fork"),
        subject: "Close ",
        expect: Grows,
    ),
    (
        id: "dialog-welcome-opens",
        group: "dialog",
        what: "the Welcome Tutorial opens its in-app setup dialog",
        open: Some("Settings"),
        hover: None,
        click: Some("Welcome Tutorial"),
        subject: "Close setup",
        expect: Paints,
    ),
    (
        id: "dialog-welcome-creates-workspace-root",
        group: "dialog",
        what: "creating the recommended workspace removes the setup action after the backend succeeds",
        open: None,
        hover: None,
        click: Some("Create recommended folder"),
        subject: "Create recommended folder",
        expect: Vanishes,
    ),
    (
        id: "dialog-welcome-closes",
        group: "dialog",
        what: "the replayed setup dialog closes without leaving the app",
        open: Some("Settings"),
        hover: None,
        click: Some("Close setup"),
        subject: "Close setup",
        expect: Vanishes,
    ),
]
