// Clipboard actions only pass when the live UI acknowledges a successful
// write. Merely activating the button is not an outcome.
[
    (
        id: "session-copy-id",
        group: "session",
        what: "copying the current session id reports that the clipboard write succeeded",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Copy session id"),
        subject: "Copied session id",
        expect: Paints,
    ),
    (
        id: "session-change-opens-editor",
        group: "session",
        what: "changing the attached session opens the standard session-id editor",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("button:Change Resume a session by id"),
        subject: "textbox:session id, e.g.",
        expect: PaintsNamed,
    ),
    (
        id: "session-change-escape-closes",
        group: "session",
        what: "Escape closes the attached-session editor",
        open: Some("theta theta north indi"),
        hover: None,
        click: None,
        key: Some("Escape"),
        key_on: Some("session id, e.g."),
        subject: "session id, e.g.",
        expect: Vanishes,
    ),
    (
        id: "session-reset-confirms",
        group: "session",
        what: "reset asks for inline confirmation before changing session state",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Reset"),
        subject: "Confirm reset",
        expect: Paints,
    ),
    (
        id: "session-reset-cancel-closes",
        group: "session",
        what: "cancel closes reset confirmation without resetting the session",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Cancel"),
        subject: "Confirm reset",
        expect: Vanishes,
    ),
]
