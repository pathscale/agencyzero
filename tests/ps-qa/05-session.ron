// Clipboard actions only pass when the live UI acknowledges a successful
// write. Merely activating the button is not an outcome.
[
    (
        id: "session-copy-id",
        group: "session",
        what: "copying the current session id reports that the clipboard write succeeded",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Copy session id"),
        subject: "Copied session id",
        expect: Paints,
    ),
    (
        id: "session-collapse-items-for-controls",
        group: "session",
        what: "collapsing Items keeps session controls inside the visible panel",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Collapse Items"),
        subject: "Expand Items",
        expect: Paints,
    ),
    (
        id: "session-collapse-task-log-for-controls",
        group: "session",
        what: "collapsing Task log keeps session controls inside the visible panel",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Collapse Task log"),
        subject: "Expand Task log",
        expect: Paints,
    ),
    (
        id: "session-open-settings-section",
        group: "session",
        what: "the project Settings section exposes the session controls",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Expand Settings"),
        subject: "Collapse Settings",
        expect: Paints,
    ),
    (
        id: "session-id-editor-paints",
        group: "session",
        what: "the standard session-id editor is directly available",
        open: Some("theta theta north indi"),
        hover: None,
        click: None,
        subject: "textbox:Resume a session by id",
        expect: PaintsNamed,
    ),
    (
        id: "session-change-persists-id",
        group: "session",
        what: "entering a replacement session id persists it into the attached-session status",
        open: None,
        hover: None,
        click: None,
        type_into: Some("textbox:Resume a session by id"),
        text: Some("019fc95e-qa-audit-session"),
        key: Some("Enter"),
        key_on: Some("textbox:Resume a session by id"),
        subject: "Attached: 019fc95e-qa-audit-session",
        expect: Paints,
    ),
    (
        id: "session-reset-confirms",
        group: "session",
        what: "reset asks for inline confirmation before changing session state",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Reset"),
        subject: "Confirm reset",
        expect: Paints,
    ),
    (
        id: "session-reset-cancel-closes",
        group: "session",
        what: "cancel closes reset confirmation without resetting the session",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Cancel"),
        subject: "Confirm reset",
        expect: Vanishes,
    ),
]
