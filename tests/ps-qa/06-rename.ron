// Project-title editing is always driven against one exact fixture row. A
// prefix-only pencil selector can rename whichever Home row happens to sort
// first and silently poison every later project-specific check.
[
    (
        id: "rename-project-header",
        group: "rename",
        what: "the project header pencil opens and Escape closes its editor",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("button:Rename project"),
        key: Some("Escape"),
        key_on: Some("textbox:Rename project"),
        subject: "button:Rename project",
        expect: PaintsNamed,
    ),
    (
        id: "rename-home-isolates-project",
        group: "rename",
        what: "Home search exposes the exact project row before its pencil is driven",
        open: Some("Home"),
        hover: None,
        click: None,
        type_into: Some("Search projects and items"),
        text: Some("theta theta north indi"),
        subject: "button:Rename project theta theta north indi",
        expect: PaintsNamed,
    ),
    (
        id: "rename-escape-keeps-name",
        group: "rename",
        what: "Escape closes the Home-row editor without changing its name",
        open: Some("Home"),
        hover: None,
        click: Some("button:Rename project theta theta north indi"),
        key: Some("Escape"),
        key_on: Some("textbox:Rename project theta theta north indi"),
        subject: "button:Rename project theta theta north indi",
        expect: PaintsNamed,
    ),
    (
        id: "rename-empty-keeps-name",
        group: "rename",
        what: "an empty replacement closes the exact editor without changing the project name",
        open: Some("Home"),
        hover: None,
        click: Some("button:Rename project theta theta north indi"),
        type_into: Some("textbox:Rename project theta theta north indi"),
        text: Some("   "),
        key: Some("Enter"),
        subject: "button:Rename project theta theta north indi",
        expect: PaintsNamed,
    ),
    (
        id: "rename-commits-typed-name",
        group: "rename",
        what: "a typed project name is accepted and the editor closes",
        open: Some("Home"),
        hover: None,
        click: Some("button:Rename project theta theta north indi"),
        type_into: Some("textbox:Rename project theta theta north indi"),
        text: Some("Renamed by ps-qa"),
        key: Some("Enter"),
        subject: "button:Rename project Renamed by ps-qa",
        expect: PaintsNamed,
    ),
    (
        id: "rename-restores-the-original-name",
        group: "rename",
        what: "the exact renamed project is restored for every later outcome",
        open: Some("Home"),
        hover: None,
        click: Some("button:Rename project Renamed by ps-qa"),
        type_into: Some("textbox:Rename project Renamed by ps-qa"),
        text: Some("theta theta north indi"),
        key: Some("Enter"),
        subject: "button:Rename project theta theta north indi",
        expect: PaintsNamed,
    ),
    (
        id: "rename-closes-on-click-away",
        group: "rename",
        what: "a real pointer press outside closes the exact open rename editor",
        open: Some("Home"),
        hover: None,
        prepare: Some("button:Rename project theta theta north indi"),
        click: Some("Sort Home"),
        press: true,
        subject: "textbox:Rename project theta theta north indi",
        expect: Vanishes,
    ),
    (
        id: "rename-home-search-restores",
        group: "rename",
        what: "rename coverage clears Home search for every later outcome",
        open: Some("Home"),
        hover: None,
        click: None,
        type_into: Some("Search projects and items"),
        text: Some(""),
        subject: "button:New Project",
        expect: PaintsNamed,
    ),
]
