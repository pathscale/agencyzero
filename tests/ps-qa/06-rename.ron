// The in-place rename editor opens when its pencil is pressed.
//
// Both call sites use the same ordinary controlled-input pattern: semantic
// button click, mounted field wrapper, explicit input ref, and queued
// focus/select after the field exists. No pointer-only event path is involved.
//
// The subject is `textbox:<name>` rather than the name alone, because
// EditableTitle gives the pencil and its editor the same accessible name: a
// name-only assertion is satisfied by the pencil whether or not the editor opens.
[
    (
        id: "rename-opens-editor",
        group: "rename",
        what: "pressing the pencil opens an editor the owner can type into",
        open: Some("Home"),
        hover: None,
        click: Some("Rename e756"),
        subject: "textbox:Rename e756",
        expect: PaintsNamed,
    ),
    (
        id: "rename-project-header",
        group: "rename",
        what: "the project header's pencil opens its editor",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Rename project"),
        subject: "textbox:Rename project",
        expect: PaintsNamed,
    ),
]
