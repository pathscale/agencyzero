// Language changes every accessible label in the application. Run this group
// alone and last: selecting Chinese is the outcome, not setup for another
// English-named check.
[
    (
        id: "language-selector-paints",
        group: "language",
        what: "the shared language selector is a named native combobox",
        open: Some("Settings"),
        hover: None,
        click: None,
        subject: "combobox:Current language: English",
        expect: PaintsNamed,
    ),
    (
        id: "language-selects-chinese",
        group: "language",
        what: "selecting the next language changes the combobox's accessible name",
        open: None,
        hover: None,
        click: None,
        key: Some("ArrowDown"),
        key_on: Some("combobox:Current language: English"),
        subject: "combobox:Current language: English",
        expect: NameChanges,
    ),
]
