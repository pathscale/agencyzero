// Language changes every accessible label in the application. Restore English
// in the same group so a complete one-process run does not poison every later
// semantic name if the harness groups checks by surface rather than filename.
[
    (
        id: "language-selector-paints",
        group: "language",
        what: "the shared language selector is a named native combobox",
        open: Some("#tabs-settings"),
        hover: None,
        click: None,
        subject: "combobox:Current language: English",
        expect: PaintsNamed,
    ),
    (
        id: "language-selects-chinese",
        group: "language",
        what: "selecting the next language replaces the old-language control tree",
        open: Some("#tabs-settings"),
        hover: None,
        click: None,
        key: Some("ArrowDown"),
        key_on: Some("combobox:Current language: English"),
        subject: "combobox:Current language: English",
        expect: Vanishes,
    ),
    (
        id: "language-repaints-workspace-in-chinese",
        group: "language",
        what: "changing language repaints labels outside the selector from the Chinese catalogue",
        open: None,
        hover: None,
        click: None,
        subject: "heading:设置",
        expect: PaintsNamed,
    ),
    (
        id: "language-restores-english",
        group: "language",
        what: "restoring English replaces the Chinese control tree",
        open: None,
        hover: None,
        click: None,
        key: Some("ArrowUp"),
        key_on: Some("combobox:当前语言: 中文"),
        subject: "combobox:当前语言: 中文",
        expect: Vanishes,
    ),
    (
        id: "language-repaints-workspace-in-english",
        group: "language",
        what: "restoring English repaints the complete settings surface for later checks",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Settings",
        expect: PaintsNamed,
    ),
]
