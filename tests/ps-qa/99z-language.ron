// Language changes every accessible label in the application. Restore English
// in the same group so a complete one-process run does not poison every later
// semantic name if the harness groups checks by surface rather than filename.
[
    (
        id: "language-selector-paints",
        group: "language",
        what: "the shared language selector is a named standard dropdown trigger",
        open: Some("Settings"),
        hover: None,
        click: None,
        subject: "#settings-language--trigger",
        expect: PaintsNamed,
    ),
    (
        id: "language-selected-value-is-visible",
        group: "language",
        what: "the shared language selector paints the selected language value",
        open: Some("Settings"),
        hover: None,
        click: None,
        // Earlier Settings checks deliberately scroll deep into Appearance.
        // Judge the selected value where a person can actually see it, not
        // from the retained offscreen box above the scrollport.
        reveal_before_capture: Some("#settings-language--trigger"),
        subject: "#settings-language--trigger",
        expect: InteriorInk,
    ),
    (
        id: "language-options-open",
        group: "language",
        what: "the shared language selector opens its standard dropdown menu",
        open: Some("Settings"),
        hover: None,
        prepare: Some("#settings-language--trigger"),
        prepare_unless: Some("menuitem:中文"),
        click: None,
        subject: "menuitem:中文",
        expect: PaintsNamed,
    ),
    (
        id: "language-options-escape-closes",
        group: "language",
        what: "Escape closes the language menu without changing the language",
        open: Some("Settings"),
        hover: None,
        prepare: Some("#settings-language--trigger"),
        prepare_unless: Some("menuitem:中文"),
        click: None,
        key: Some("Escape"),
        key_on: Some("menuitem:中文"),
        subject: "menuitem:中文",
        expect: Vanishes,
    ),
    (
        id: "language-selects-chinese",
        group: "language",
        what: "choosing Chinese replaces the old-language control tree",
        open: Some("Settings"),
        hover: None,
        prepare: Some("#settings-language--trigger"),
        prepare_unless: Some("menuitem:中文"),
        click: Some("menuitem:中文"),
        subject: "Current language: English",
        expect: Vanishes,
    ),
    (
        id: "language-repaints-workspace-in-chinese",
        group: "language",
        what: "changing language repaints labels outside the selector from the Chinese catalogue",
        open: None,
        hover: None,
        click: None,
        subject: "heading:设置",
        expect: PaintsNamed,
    ),
    (
        id: "language-restores-english",
        group: "language",
        what: "choosing English replaces the Chinese control tree",
        open: None,
        hover: None,
        prepare: Some("#settings-language--trigger"),
        prepare_unless: Some("menuitem:English"),
        click: Some("menuitem:English"),
        subject: "当前语言: 中文",
        expect: Vanishes,
    ),
    (
        id: "language-repaints-workspace-in-english",
        group: "language",
        what: "restoring English repaints the complete settings surface for later checks",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Settings",
        expect: PaintsNamed,
    ),
]
