// Standard value-bearing controls are verified through their semantic value,
// not their unchanged geometry. The disposable QA profile absorbs the writes.
[
    (
        id: "toggles-moderator",
        group: "toggles",
        what: "the unwired session moderator cannot pretend to change live behavior",
        open: Some("theta theta north indi"),
        hover: None,
        click: None,
        subject: "Moderator for this session",
        expect: Disabled,
    ),
    (
        id: "toggles-raw-exchange",
        group: "toggles",
        what: "raw Agent I/O persistence changes",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Keep this project's raw exchange in the database"),
        subject: "Keep this project's raw exchange in the database",
        expect: ValueChanges,
    ),
    (
        id: "toggles-raw-exchange-restores",
        group: "toggles",
        what: "raw Agent I/O persistence can be restored on the same checkbox",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Keep this project's raw exchange in the database"),
        subject: "Keep this project's raw exchange in the database",
        expect: ValueChanges,
    ),
    (
        id: "toggles-checkpoints",
        group: "toggles",
        what: "project knowledge checkpoints change",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Knowledge checkpoints for this project"),
        subject: "Knowledge checkpoints for this project",
        expect: ValueChanges,
    ),
    (
        id: "toggles-checkpoints-restores",
        group: "toggles",
        what: "project knowledge checkpoints return to the fixture value",
        open: Some("theta theta north indi"),
        hover: None,
        click: Some("Knowledge checkpoints for this project"),
        subject: "Knowledge checkpoints for this project",
        expect: ValueChanges,
    ),
    (
        id: "toggles-profiling",
        group: "toggles",
        what: "deep profiling permission changes",
        open: Some("Settings"),
        hover: None,
        click: Some("Allow deep intrusive profiling"),
        subject: "Allow deep intrusive profiling",
        expect: ValueChanges,
    ),
    (
        id: "toggles-update-checks",
        group: "toggles",
        what: "automatic update checks change",
        open: Some("Settings"),
        hover: None,
        click: Some("Check for updates at launch"),
        subject: "Check for updates at launch",
        expect: ValueChanges,
    ),
    (
        id: "toggles-prompt-syntax",
        group: "toggles",
        what: "per-turn AgencyZero and Prompt Syntax injection changes",
        open: Some("Settings"),
        hover: None,
        click: Some("Inject AgencyZero and Prompt Syntax per turn"),
        subject: "Inject AgencyZero and Prompt Syntax per turn",
        expect: ValueChanges,
    ),
    (
        id: "toggles-agent-settings-updates",
        group: "toggles",
        what: "agent permission to update application settings changes on its exact switch",
        open: Some("Settings"),
        hover: None,
        click: Some("#settings-agent-settings-updates"),
        subject: "#settings-agent-settings-updates",
        expect: ValueChanges,
    ),
    (
        id: "toggles-profiling-restores",
        group: "toggles",
        what: "deep profiling permission returns to the fixture value",
        open: Some("Settings"),
        hover: None,
        click: Some("Allow deep intrusive profiling"),
        subject: "Allow deep intrusive profiling",
        expect: ValueChanges,
    ),
    (
        id: "toggles-update-checks-restores",
        group: "toggles",
        what: "automatic update checks return to the fixture value",
        open: Some("Settings"),
        hover: None,
        click: Some("Check for updates at launch"),
        subject: "Check for updates at launch",
        expect: ValueChanges,
    ),
    (
        id: "toggles-prompt-syntax-restores",
        group: "toggles",
        what: "per-turn Prompt Syntax injection returns to the fixture value",
        open: Some("Settings"),
        hover: None,
        click: Some("Inject AgencyZero and Prompt Syntax per turn"),
        subject: "Inject AgencyZero and Prompt Syntax per turn",
        expect: ValueChanges,
    ),
    (
        id: "toggles-agent-settings-updates-restores",
        group: "toggles",
        what: "agent settings permission returns to the fixture value",
        open: Some("Settings"),
        hover: None,
        click: Some("#settings-agent-settings-updates"),
        subject: "#settings-agent-settings-updates",
        expect: ValueChanges,
    ),
]
