{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgencyZero Blitz",
  "mainBinaryName": "agencyzero-blitz",
  "identifier": "com.pathscale.agencyzero.blitz",
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "AgencyZero Blitz",
        "width": 1344,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0a0b0d",
        "transparent": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "createUpdaterArtifacts": false,
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
