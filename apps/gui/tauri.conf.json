{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgencyZero",
  "version": "0.1.0",
  "identifier": "com.pathscale.agencyzero",
  "build": {
    "frontendDist": "dist",
    "devUrl": "http://localhost:3010",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AgencyZero",
        "width": 1344,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0a0b0d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns"]
  }
}
