{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgencyZero",
  "identifier": "com.pathscale.agencyzero",
  "build": {
    "frontendDist": "dist",
    "devUrl": "http://localhost:3010",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "AgencyZero",
        "width": 1344,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://24x.ai/agencyzero/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4ODE4RTQwQjQ1RUExQkUKUldTK29WNjBRSTZCZUJtZkdsZ2RFWHZzK1hXaGJ3b0RtdUpRWDJLVk1sMWhaZEdJSjNIOVVaN1oK"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/agency-proxy"
    ],
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
