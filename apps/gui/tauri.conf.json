{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgencyZero",
  "version": "0.1.0",
  "identifier": "com.pathscale.agencyzero",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AgencyZero",
        "width": 900,
        "height": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns"]
  }
}
