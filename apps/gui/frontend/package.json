{
  "name": "az-gui-frontend",
  "version": "0.1.0",
  "description": "AgencyZero — Tauri GUI frontend",
  "type": "module",
  "private": true,
  "overrides": {
    "babel-preset-solid": "2.0.0-rc.0"
  },
  "scripts": {
    "dev": "bun --bun rsbuild dev",
    "start": "bun --bun rsbuild dev",
    "build": "bun run typecheck && bun --bun rsbuild build",
    "preview": "bun --bun rsbuild preview",
    "typecheck": "bun --bun tsc --noEmit",
    "lint": "./scripts/biome.sh check .",
    "lint:ui-controls": "bun scripts/check-ui-controls.ts",
    "format": "./scripts/biome.sh format . --write",
    "test": "bun --bun vitest",
    "test:run": "NODE_ENV=production bun --bun vitest run",
    "test:coverage": "bun --bun vitest run --coverage",
    "bench": "bun --bun vitest run --config vitest.bench.config.ts --reporter=verbose"
  },
  "license": "MIT",
  "dependencies": {
    "@pathscale/ui": "^2.10.0",
    "@tauri-apps/api": "^2.1.1",
    "clsx": "^2.1.1",
    "popmotion": "^11.0.5",
    "promptsyntax": "^0.1.0",
    "solid-js": "2.0.0-rc.0",
    "solid-layouts": "^0.2.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@rsbuild/core": "^1.3.20",
    "@rsbuild/plugin-babel": "^1.0.5",
    "@rsbuild/plugin-solid": "^1.0.5",
    "@solidjs/testing-library": "1.0.0-beta.2",
    "@tailwindcss/postcss": "^4.1.7",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "^22.15.17",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-preset-solid": "2.0.0-rc.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "jsdom": "^30.0.0",
    "rsbuild-plugin-solid-layouts": "^0.2.1",
    "tailwindcss": "^4.0.7",
    "typescript": "^5.7.2",
    "vite-plugin-solid": "3.0.0-next.27",
    "vitest": "^4.1.10"
  }
}
