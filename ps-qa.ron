// What ps-qa has to be told about this application.
//
// The harness is a harness: it knows how to drive a Blitz app through its
// control socket and judge what the renderer did. It does not know that this
// product has a surface called Analytics or a section called `Agent I/O`, and
// it should not. Those facts live here, next to the application that owns them.
//
// Data rather than code, so correcting a name is an edit and a re-run rather
// than an edit, a recompile and a re-run.
AppProfile(
    // Home last: it owns the destructive project-row controls, so visiting it
    // before the others would delete the rows those others are reached through.
    surfaces: [
        (name: "project",   opener: "\u{0}dynamic-document", marker: Some("Send")),
        (
            name: "settings",
            opener: "Settings",
            marker: Some("Appearance"),
            reveal_with: Some("Search settings"),
        ),
        (name: "analytics", opener: "Analytics", marker: Some("Outcome per dollar")),
        (name: "home",      opener: "Home", marker: Some("Sort Home")),
    ],

    // Always in the strip, never a document. The doubled form is accepted too,
    // because a tab's accessible name repeats its label (`HomeHome`).
    permanent_surfaces: ["Home", "Settings", "Analytics"],

    // Alternate navigation entry points. They are exercised when opening the
    // destination surface, never halfway through a source-surface plan.
    navigation_controls: ["Open Settings"],

    // Collapsible headers, by label without the count.
    //
    // Getting this list wrong is expensive rather than cosmetic: a collapse
    // takes everything under it off screen, so folding a section a dozen
    // controls before the sweep reaches its rows makes every one of them read
    // as vanished. That is exactly how the fork dialog escaped the audit.
    sections: [
        "Items",
        "Running",
        "Task log",
        "Agent I/O",
        "Kept across compaction",
        "Recent",
    ],

    // How a Home row announces itself. The project's own name is scrubbed and
    // differs per profile, so the summary beside it is the only stable handle.
    document_row_markers: [" open \u{b7} ", "no working directory", " ago"],
    // The scrubbed validation profile gives its primary project this stable
    // name. Reuse its open surface across checks instead of returning Home and
    // remounting the same project before every outcome.
    document_openers: ["theta theta north indi"],
    // Home and the project panel both page rich rows. Inventory expands them
    // by semantic node id before counting every concrete row instance.
    pagination_controls: [" more projects", " more items"],

    // Verbs this application's controls start with. Swept last, or excluded
    // from the search for a control that opens a document.
    close_prefixes: ["Close "],
    // Preferred ways out of any in-app dialog. Native panels and external
    // destinations remain manual; these are ordinary semantic controls.
    dismiss_controls: [
        "Cancel",
        "Dismiss",
        "Close setup",
        "Finish setup later",
        "Close",
    ],
    row_action_prefixes: ["Rename "],
    fold_prefixes: ["Collapse ", "Hide "],
    deferred_controls: [
        "New project",
    ],

    // These actions need a disposable application process. A successful
    // Disabling inspection closes the control socket; reset and sign-out
    // invalidate the QA fixture. They stay automated work, but never run in
    // the shared sweep. Application and sidecar restart remain manual because
    // process replacement prevents reliable cleanup and continuation.
    isolated_controls: [
        "Start fork",
        "Reset all",
        "Sign out",
        "Enable inspection and agent control",
    ],

    // Every current control has a rendered acknowledgement. Keep this empty so
    // the broad sweep rejects a click that changes nothing; copy controls are
    // recognised generically by their accessible verb.
    inert_controls: [],

    // Controls reserved for the manual release pass: native dialogs the
    // harness cannot close and external destinations that leave this app.
    // These are counted and named, but never activated unattended.
    //
    // Re-derive with: grep -n '\.dialog()' apps/gui/src/*.rs
    // If that count changes, this list is stale.
    manual_controls: [
        (label: "Attach files",                        command: "choose_attachments"),
        (label: "Add dir",                             command: "choose_project_directory"),
        (label: "Choose folder",                       command: "choose_project_directory (Welcome)"),
        (label: "Select backup file",                  command: "select_store_backup"),
        (label: "Back up & close",                     command: "create_store_backup"),
        (label: "Export",                              command: "export_study_events"),
        // Both visible Settings rows use this standard label: the data
        // directory picker and the AgencyProxy executable picker. Their native
        // panels cannot be closed headlessly.
        (label: "Choose\u{2026}",                       command: "choose_data_directory / choose_agent_proxy_binary"),

        // Restarting the sidecar can invalidate the control transport used by
        // the rest of the audit. Verify it in the manual release pass instead
        // of destabilising a shared semantic sweep.
        (label: "Restart AgencyProxy",                  command: "restart_agent_proxy"),
        (label: "Restart",                              command: "restart_app"),

        // A real turn needs an authenticated paid provider. CI proves the
        // disconnected-agent gate; an owner launches and verifies every entry
        // point into a real provider turn locally.
        (label: "Send",                                 command: "authenticated provider turn (local manual)"),
        (label: "Run ",                                 command: "authenticated item run (local manual)"),
        (label: "Reply to the question for ",           command: "authenticated item reply (local manual)"),

        // Controls that hand the screen to the *browser*. Same problem as a
        // native panel and worse manners: a sweep that presses these opens a
        // tab on the owner's desktop for every PR and issue on screen.
        (label: "Open http",                           command: "openExternal (link)"),
        (label: "View source",                         command: "openExternal (repository)"),
        (label: "Star on GitHub",                      command: "openExternal (repository)"),
    ],

    transcript_region: Some("Conversation"),
    home_opener: Some("Home"),
)
